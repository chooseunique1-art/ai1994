---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// Only 'published' posts appear. Drafts stay invisible on the live site.
const posts = (await getCollection('blog', ({ data }) => data.status === 'published')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });

const readTime = (body: string | undefined) => {
  const words = (body ?? '').trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(words / 200));
};

// The hero slot is impact-driven, not purely chronological: a genuinely
// urgent story (marked `breaking` by the pipeline) takes the lead position
// even if a less important story published more recently. If nothing is
// flagged breaking, the most recent post leads as before. Everything below
// the hero stays in true recency order.
const breakingPost = posts.find((p) => p.data.breaking);
const orderedPosts = breakingPost
  ? [breakingPost, ...posts.filter((p) => p.id !== breakingPost.id)]
  : posts;

// The hero also requires an image — a text-only lead looks broken next to
// every other slot on the page having a photo. Skip ahead (in the same
// breaking-first, then recency order above) to the first candidate that
// actually has one; whatever gets skipped isn't lost, it just falls back
// into the normal secondary/sidebar order below instead of leading. Only
// falls back to an image-less post if literally nothing published has an
// image yet, so the homepage still has something to show.
const heroIndex = orderedPosts.findIndex((p) => p.data.image);
const topIndex = heroIndex === -1 ? 0 : heroIndex;
const top = orderedPosts[topIndex];
const rest = [...orderedPosts.slice(0, topIndex), ...orderedPosts.slice(topIndex + 1)];

const [second, third, ...sidebarRest] = rest;
const secondaries = [second, third].filter(Boolean);

// Fills the gap on desktop where the sidebar list runs longer than the
// lead column (handoff doc §5.3/7 — previously undecided). Text-only,
// no images, reusing the same pool as the sidebar rather than any new
// data or pipeline change. Hidden on mobile via CSS since it would just
// duplicate the sidebar there.
const briefItems = sidebarRest.slice(0, 6);

// Sidebar is capped rather than showing every published post ever —
// with hundreds of posts accumulating over time, an uncapped list was
// both the actual source of the persistent layout gap (a much shorter
// lead column paired against an ever-growing sidebar) and a genuinely
// long single-page list in its own right. Anything beyond the cap is
// still reachable via the archive page.
const SIDEBAR_LIMIT = 15;
const sidebarShown = sidebarRest.slice(0, SIDEBAR_LIMIT);
const hasMoreStories = sidebarRest.length > SIDEBAR_LIMIT;

// "Trending" strip — a random sample re-rolled on every build, not a real
// engagement metric (no click data exists yet), so it's labeled "Trending"
// rather than "Most Read". Two-tier pool rather than pure recency: a
// genuinely major story (pipeline-flagged breaking) stays eligible for a
// few days even as it ages past the "most recent" window, so an ongoing
// story doesn't vanish from Trending just because the clock moved on. The
// remainder of the pool is filled with the most recent non-breaking posts
// so the strip still skews current day-to-day.
const TRENDING_COUNT = 6;
const RECENT_POOL = 30;
const BREAKING_WINDOW_MS = 3 * 24 * 60 * 60 * 1000; // 3 days
const now = Date.now();

const recentBreaking = posts.filter(
  (p) => p.data.breaking && now - p.data.pubDate.valueOf() <= BREAKING_WINDOW_MS
);
const recentPosts = posts.slice(0, RECENT_POOL);

const trendingPoolMap = new Map(
  [...recentBreaking, ...recentPosts].map((p) => [p.id, p])
);
const trendingPool = [...trendingPoolMap.values()];

const trending = [...trendingPool].sort(() => Math.random() - 0.5).slice(0, TRENDING_COUNT);

// The pipeline runs hourly but doesn't always publish something new, and
// since this is a static build (only rebuilds on a new commit), the hero
// would otherwise just sit frozen whenever nothing new came in. Rotating
// it client-side, once per hour, among recent image-bearing stories means
// the homepage still feels alive between rebuilds. A genuine breaking
// story stays pinned — rotation is skipped entirely in that case.
const HERO_ROTATION_COUNT = 8;
const heroIsBreaking = Boolean(top.data.breaking);
const heroCandidates = heroIsBreaking
  ? []
  : orderedPosts
      .filter((p) => p.data.image)
      .slice(0, HERO_ROTATION_COUNT)
      .map((p) => ({
        id: p.id,
        title: p.data.title,
        description: p.data.description,
        image: p.data.image,
        region: p.data.region ?? null,
        sourceName: p.data.sourceName ?? null,
        date: fmt(p.data.pubDate),
        readTime: readTime(p.body),
      }));
const heroCandidatesJson = JSON.stringify(heroCandidates).replace(/</g, '\\u003c');

const regions = [...new Set(posts.map((p) => p.data.region).filter((r): r is string => Boolean(r)))].sort(
  (a, b) => a.localeCompare(b)
);
---

<Base title="The South Press">
  {posts.length === 0 && <p class="empty">No published posts yet.</p>}

  {
    top && (
      <div class="home">
        <nav class="chip-rail" aria-label="Filter by section">
          <button type="button" class="chip is-active" data-chip-region="" aria-pressed="true">
            Top
          </button>
          {regions.map((region) => (
            <button type="button" class="chip" data-chip-region={region} aria-pressed="false">
              {region}
            </button>
          ))}
        </nav>

        <div class="content-grid">
          <div class="lead-col">
            <a
              class={`lead ${top.data.image ? '' : 'lead-no-image'}`}
              href={`/blog/${top.id}/`}
              data-hero-link
              data-hero-static={heroIsBreaking ? 'true' : 'false'}
            >
              {top.data.image && (
                <img class="lead-image" src={top.data.image} alt="" loading="eager" data-hero-image />
              )}
              <span class="eyebrow" data-hero-eyebrow>{top.data.breaking ? 'Breaking' : 'The lead'}</span>
              <h2 class="headline" data-hero-headline>{top.data.title}</h2>
              <p class="brief" data-hero-brief>{top.data.description}</p>
              <div class="meta" data-hero-meta>
                {fmt(top.data.pubDate)}
                {top.data.region && ` | ${top.data.region}`}
                <span class="dot">·</span>
                <span class="handle">{top.data.sourceName}</span>
                <span class="dot">·</span>
                {readTime(top.body)} min
              </div>
            </a>

            {secondaries.length > 0 && (
              <div class="lead-secondaries">
                {secondaries.map((post) => (
                  <a class="secondary-story" href={`/blog/${post.id}/`} data-region={post.data.region ?? ''}>
                    {post.data.image && <img class="secondary-thumb" src={post.data.image} alt="" loading="lazy" />}
                    <div class="secondary-body">
                      <h3 class="headline">{post.data.title}</h3>
                      <p class="brief">{post.data.description}</p>
                      <div class="meta">
                        {fmt(post.data.pubDate)}
                        {post.data.region && ` | ${post.data.region}`}
                        <span class="dot">·</span>
                        <span class="handle">{post.data.sourceName}</span>
                        <span class="dot">·</span>
                        {readTime(post.body)} min
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            )}

            {briefItems.length > 0 && (
              <div class="in-brief">
                <div class="in-brief-label">In Brief</div>
                <ul class="in-brief-list">
                  {briefItems.map((post) => (
                    <li>
                      <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          <div class="sidebar">
            <ol class="ranked-list" data-ranked-list>
              {sidebarShown.map((post) => (
                <li class="ranked-row" data-region={post.data.region ?? ''}>
                  <a class="story-link" href={`/blog/${post.id}/`}>
                    <div class={`story-row ${post.data.image ? '' : 'no-image'}`}>
                      {post.data.image && <img class="thumb" src={post.data.image} alt="" loading="lazy" />}
                      <div class="story-body">
                        <h3 class="headline">{post.data.title}</h3>
                        <div class="meta">
                          {post.data.region ?? 'Top'}
                          <span class="dot">·</span>
                          {readTime(post.body)} min
                        </div>
                      </div>
                    </div>
                  </a>
                </li>
              ))}
            </ol>

            <p class="ranked-empty" data-ranked-empty hidden>
              No other stories in this section right now.
            </p>

            {hasMoreStories && (
              <a class="more-stories-link" href="/archive/">
                More stories →
              </a>
            )}
          </div>
        </div>

        {
          trending.length > 0 && (
            <div class="trending-grid">
              <div class="trending-label">Trending</div>
              <div class="trending-items">
                {trending.map((post) => (
                  <a class="trending-card" href={`/blog/${post.id}/`}>
                    {post.data.image && <img class="trending-thumb" src={post.data.image} alt="" loading="lazy" />}
                    <h3 class="headline">{post.data.title}</h3>
                  </a>
                ))}
              </div>
            </div>
          )
        }

        {
          regions.length > 0 && (
            <div class="sections-grid">
              <div class="sections-label">More sections</div>
              <div class="sections-items">
                {regions.map((region) => (
                  <button type="button" class="section-link" data-chip-region={region}>
                    {region}
                  </button>
                ))}
              </div>
            </div>
          )
        }
      </div>
    )
  }

  <script type="application/json" data-hero-candidates set:html={heroCandidatesJson} />
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-chip-region]');
  const rows = document.querySelectorAll<HTMLLIElement>('[data-ranked-list] > li[data-region]');
  const secondaryRows = document.querySelectorAll<HTMLAnchorElement>('.secondary-story[data-region]');
  const emptyMsg = document.querySelector<HTMLElement>('[data-ranked-empty]');

  function applyFilter(region: string) {
    let visibleCount = 0;

    rows.forEach((row) => {
      const match = region === '' || row.dataset.region === region;
      row.hidden = !match;
      if (match) visibleCount++;
    });

    secondaryRows.forEach((row) => {
      const match = region === '' || row.dataset.region === region;
      (row as HTMLElement).style.display = match ? '' : 'none';
    });

    if (emptyMsg) emptyMsg.hidden = visibleCount > 0;

    chips.forEach((chip) => {
      const active = chip.dataset.chipRegion === region;
      chip.classList.toggle('is-active', active);
      chip.setAttribute('aria-pressed', String(active));
    });
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => applyFilter(chip.dataset.chipRegion ?? ''));
  });

  const initialRegion = new URLSearchParams(location.search).get('region');
  if (initialRegion && [...chips].some((chip) => chip.dataset.chipRegion === initialRegion)) {
    applyFilter(initialRegion);
  }

  const heroLink = document.querySelector<HTMLAnchorElement>('[data-hero-link]');
  const heroCandidatesTag = document.querySelector<HTMLScriptElement>('[data-hero-candidates]');

  if (heroLink && heroCandidatesTag && heroLink.dataset.heroStatic !== 'true') {
    type HeroCandidate = {
      id: string;
      title: string;
      description: string;
      image: string;
      region: string | null;
      sourceName: string | null;
      date: string;
      readTime: number;
    };

    const candidates: HeroCandidate[] = JSON.parse(heroCandidatesTag.textContent || '[]');

    if (candidates.length > 1) {
      const hourSeed = Math.floor(Date.now() / (60 * 60 * 1000));
      const pick = candidates[hourSeed % candidates.length];

      const img = heroLink.querySelector<HTMLImageElement>('[data-hero-image]');
      const eyebrow = heroLink.querySelector<HTMLElement>('[data-hero-eyebrow]');
      const headline = heroLink.querySelector<HTMLElement>('[data-hero-headline]');
      const brief = heroLink.querySelector<HTMLElement>('[data-hero-brief]');
      const meta = heroLink.querySelector<HTMLElement>('[data-hero-meta]');

      if (img) img.src = pick.image;
      if (eyebrow) eyebrow.textContent = 'The lead';
      if (headline) headline.textContent = pick.title;
      if (brief) brief.textContent = pick.description;

      if (meta) {
        meta.innerHTML = '';
        meta.append(document.createTextNode(pick.date + (pick.region ? ` | ${pick.region}` : '')));

        const dot1 = document.createElement('span');
        dot1.className = 'dot';
        dot1.textContent = '·';
        meta.append(dot1);

        const handle = document.createElement('span');
        handle.className = 'handle';
        handle.textContent = pick.sourceName ?? '';
        meta.append(handle);

        const dot2 = document.createElement('span');
        dot2.className = 'dot';
        dot2.textContent = '·';
        meta.append(dot2);

        meta.append(document.createTextNode(`${pick.readTime} min`));
      }

      heroLink.href = `/blog/${pick.id}/`;
    }
  }
</script>
