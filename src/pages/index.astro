---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// Only 'published' posts appear. Drafts stay invisible on the live site.
const posts = (await getCollection('blog', ({ data }) => data.status === 'published')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title="ai1994">
  {posts.length === 0 && <p class="empty">No published posts yet.</p>}

  {
    posts.map((post) => (
      <article>
        <div class="meta">
          {fmt(post.data.pubDate)} — {post.data.sourceName}
        </div>
        <h2>
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        </h2>
        <p>{post.data.description}</p>
      </article>
    ))
  }
</Base>
