---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// Only 'published' posts appear. Drafts stay invisible on the live site.
const posts = (await getCollection('blog', ({ data }) => data.status === 'published')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });

const readTime = (body: string | undefined) => {
  const words = (body ?? '').trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(words / 200));
};

// The hero slot is impact-driven, not purely chronological: a genuinely
// urgent story (marked `breaking` by the pipeline) takes the lead position
// even if a less important story published more recently. If nothing is
// flagged breaking, the most recent post leads as before. Everything below
// the hero stays in true recency order.
const breakingPost = posts.find((p) => p.data.breaking);
const orderedPosts = breakingPost
  ? [breakingPost, ...posts.filter((p) => p.id !== breakingPost.id)]
  : posts;

const [top, second, third, ...sidebarRest] = orderedPosts;
const secondaries = [second, third].filter(Boolean);

// Fills the gap on desktop where the sidebar list runs longer than the
// lead column (handoff doc §5.3/7 — previously undecided). Text-only,
// no images, reusing the same pool as the sidebar rather than any new
// data or pipeline change. Hidden on mobile via CSS since it would just
// duplicate the sidebar there.
const briefItems = sidebarRest.slice(0, 6);

// Sidebar is capped rather than showing every published post ever —
// with hundreds of posts accumulating over time, an uncapped list was
// both the actual source of the persistent layout gap (a much shorter
// lead column paired against an ever-growing sidebar) and a genuinely
// long single-page list in its own right. Anything beyond the cap is
// still reachable via the archive page.
const SIDEBAR_LIMIT = 15;
const sidebarShown = sidebarRest.slice(0, SIDEBAR_LIMIT);
const hasMoreStories = sidebarRest.length > SIDEBAR_LIMIT;

const regions = [...new Set(posts.map((p) => p.data.region).filter((r): r is string => Boolean(r)))].sort(
  (a, b) => a.localeCompare(b)
);
---

<Base title="The South Press">
  {posts.length === 0 && <p class="empty">No published posts yet.</p>}

  {
    top && (
      <div class="home">
        <nav class="chip-rail" aria-label="Filter by section">
          <button type="button" class="chip is-active" data-chip-region="" aria-pressed="true">
            Top
          </button>
          {regions.map((region) => (
            <button type="button" class="chip" data-chip-region={region} aria-pressed="false">
              {region}
            </button>
          ))}
        </nav>

        <div class="content-grid">
          <div class="lead-col">
            <a class={`lead ${top.data.image ? '' : 'lead-no-image'}`} href={`/blog/${top.id}/`}>
              {top.data.image && <img class="lead-image" src={top.data.image} alt="" loading="eager" />}
              <span class="eyebrow">{top.data.breaking ? 'Breaking' : 'The lead'}</span>
              <h2 class="headline">{top.data.title}</h2>
              <p class="brief">{top.data.description}</p>
              <div class="meta">
                {fmt(top.data.pubDate)}
                {top.data.region && ` | ${top.data.region}`}
                <span class="dot">·</span>
                <span class="handle">{top.data.sourceName}</span>
                <span class="dot">·</span>
                {readTime(top.body)} min
              </div>
            </a>

            {secondaries.length > 0 && (
              <div class="lead-secondaries">
                {secondaries.map((post) => (
                  <a class="secondary-story" href={`/blog/${post.id}/`} data-region={post.data.region ?? ''}>
                    {post.data.image && <img class="secondary-thumb" src={post.data.image} alt="" loading="lazy" />}
                    <div class="secondary-body">
                      <h3 class="headline">{post.data.title}</h3>
                      <p class="brief">{post.data.description}</p>
                      <div class="meta">
                        {fmt(post.data.pubDate)}
                        {post.data.region && ` | ${post.data.region}`}
                        <span class="dot">·</span>
                        <span class="handle">{post.data.sourceName}</span>
                        <span class="dot">·</span>
                        {readTime(post.body)} min
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            )}

            {briefItems.length > 0 && (
              <div class="in-brief">
                <div class="in-brief-label">In Brief</div>
                <ul class="in-brief-list">
                  {briefItems.map((post) => (
                    <li>
                      <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          <div class="sidebar">
            <ol class="ranked-list" data-ranked-list>
              {sidebarShown.map((post) => (
                <li class="ranked-row" data-region={post.data.region ?? ''}>
                  <a class="story-link" href={`/blog/${post.id}/`}>
                    <div class={`story-row ${post.data.image ? '' : 'no-image'}`}>
                      {post.data.image && <img class="thumb" src={post.data.image} alt="" loading="lazy" />}
                      <div class="story-body">
                        <h3 class="headline">{post.data.title}</h3>
                        <div class="meta">
                          {post.data.region ?? 'Top'}
                          <span class="dot">·</span>
                          {readTime(post.body)} min
                        </div>
                      </div>
                    </div>
                  </a>
                </li>
              ))}
            </ol>

            <p class="ranked-empty" data-ranked-empty hidden>
              No other stories in this section right now.
            </p>

            {hasMoreStories && (
              <a class="more-stories-link" href="/archive/">
                More stories →
              </a>
            )}
          </div>
        </div>

        {
          regions.length > 0 && (
            <div class="sections-grid">
              <div class="sections-label">More sections</div>
              <div class="sections-items">
                {regions.map((region) => (
                  <button type="button" class="section-link" data-chip-region={region}>
                    {region}
                  </button>
                ))}
              </div>
            </div>
          )
        }
      </div>
    )
  }
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-chip-region]');
  const rows = document.querySelectorAll<HTMLLIElement>('[data-ranked-list] > li[data-region]');
  const secondaryRows = document.querySelectorAll<HTMLAnchorElement>('.secondary-story[data-region]');
  const emptyMsg = document.querySelector<HTMLElement>('[data-ranked-empty]');

  function applyFilter(region: string) {
    let visibleCount = 0;

    rows.forEach((row) => {
      const match = region === '' || row.dataset.region === region;
      row.hidden = !match;
      if (match) visibleCount++;
    });

    secondaryRows.forEach((row) => {
      const match = region === '' || row.dataset.region === region;
      (row as HTMLElement).style.display = match ? '' : 'none';
    });

    if (emptyMsg) emptyMsg.hidden = visibleCount > 0;

    chips.forEach((chip) => {
      const active = chip.dataset.chipRegion === region;
      chip.classList.toggle('is-active', active);
      chip.setAttribute('aria-pressed', String(active));
    });
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => applyFilter(chip.dataset.chipRegion ?? ''));
  });

  const initialRegion = new URLSearchParams(location.search).get('region');
  if (initialRegion && [...chips].some((chip) => chip.dataset.chipRegion === initialRegion)) {
    applyFilter(initialRegion);
  }
</script>
