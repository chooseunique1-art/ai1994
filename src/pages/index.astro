---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// Only 'published' posts appear. Drafts stay invisible on the live site.
const posts = (await getCollection('blog', ({ data }) => data.status === 'published')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Date only, never relative time — several stories can publish in the same
// batch, so "3 hours ago" for all of them would be misleading.
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });

const [top, ...rest] = posts;
---

<Base title="ai1994">
  {posts.length === 0 && <p class="empty">No published posts yet.</p>}

  {
    top && (
      <div class="feed">
        <a class="story-link top-story" href={`/blog/${top.id}/`}>
          {top.data.image ? (
            <img class="top-image" src={top.data.image} alt="" loading="eager" />
          ) : (
            top.data.region && <span class="region-label">{top.data.region}</span>
          )}
          <h2 class="headline">{top.data.title}</h2>
          <p class="brief">{top.data.description}</p>
          <div class="meta">
            {fmt(top.data.pubDate)}
            {top.data.region && ` | ${top.data.region}`}
            <span class="dot">·</span>
            <span class="handle">{top.data.sourceName}</span>
          </div>
        </a>

        {rest.map((post) => (
          <a class="story-link" href={`/blog/${post.id}/`}>
            <div class={`story-row ${post.data.image ? '' : 'no-image'}`}>
              {post.data.image && <img class="thumb" src={post.data.image} alt="" loading="lazy" />}
              <div class="story-body">
                {!post.data.image && post.data.region && (
                  <span class="region-label">{post.data.region}</span>
                )}
                <h3 class="headline">{post.data.title}</h3>
                <div class="meta">
                  {fmt(post.data.pubDate)}
                  {post.data.region && ` | ${post.data.region}`}
                  <span class="dot">·</span>
                  <span class="handle">{post.data.sourceName}</span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    )
  }
</Base>
