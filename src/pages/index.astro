---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// Only 'published' posts appear. Drafts stay invisible on the live site.
const posts = (await getCollection('blog', ({ data }) => data.status === 'published')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Date only, never relative time — several stories can publish in the same
// batch, so "3 hours ago" for all of them would be misleading.
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });

const [top, ...rest] = posts;

// Desktop-only sidebar. Reads further into the same `posts` array already
// fetched above — no new query. Below the 1024px breakpoint none of this
// renders (see .sidebar / .beyond-cap in Base.astro), so the mobile feed
// is untouched and still shows every post.
const regions = [...new Set(posts.map((post) => post.data.region).filter((r): r is string => Boolean(r)))].sort(
  (a, b) => a.localeCompare(b)
);

// On desktop the main column shows the top story + 11 rows (12 total);
// the sidebar picks up the next 10 headlines after that.
const DESKTOP_FEED_CAP = 12;
const SIDEBAR_HEADLINE_COUNT = 10;
const sidebarPosts = posts.slice(DESKTOP_FEED_CAP, DESKTOP_FEED_CAP + SIDEBAR_HEADLINE_COUNT);
---

<Base title="ai1994">
  {posts.length === 0 && <p class="empty">No published posts yet.</p>}

  {
    top && (
      <div class="content">
        <div class="feed">
          <a class="story-link top-story" href={`/blog/${top.id}/`}>
            {top.data.image ? (
              <img class="top-image" src={top.data.image} alt="" loading="eager" />
            ) : (
              top.data.region && <span class="region-label">{top.data.region}</span>
            )}
            <h2 class="headline">{top.data.title}</h2>
            <p class="brief">{top.data.description}</p>
            <div class="meta">
              {fmt(top.data.pubDate)}
              {top.data.region && ` | ${top.data.region}`}
              <span class="dot">·</span>
              <span class="handle">{top.data.sourceName}</span>
            </div>
          </a>

          {rest.map((post, i) => (
            <a
              class={`story-link${i >= DESKTOP_FEED_CAP - 1 ? ' beyond-cap' : ''}`}
              href={`/blog/${post.id}/`}
            >
              <div class={`story-row ${post.data.image ? '' : 'no-image'}`}>
                {post.data.image && <img class="thumb" src={post.data.image} alt="" loading="lazy" />}
                <div class="story-body">
                  {!post.data.image && post.data.region && (
                    <span class="region-label">{post.data.region}</span>
                  )}
                  <h3 class="headline">{post.data.title}</h3>
                  <div class="meta">
                    {fmt(post.data.pubDate)}
                    {post.data.region && ` | ${post.data.region}`}
                    <span class="dot">·</span>
                    <span class="handle">{post.data.sourceName}</span>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>

        <aside class="sidebar">
          <section class="sidebar-section">
            <h2 class="sidebar-heading">Regions</h2>
            <ul class="region-list">
              {regions.map((region) => (
                <li>
                  <a href={`/region/${encodeURIComponent(region)}`}>{region}</a>
                </li>
              ))}
            </ul>
          </section>

          <section class="sidebar-section">
            <h2 class="sidebar-heading">More headlines</h2>
            <ul class="headline-list">
              {sidebarPosts.map((post) => (
                <li>
                  <a href={`/blog/${post.id}/`}>
                    <span class="headline-text">{post.data.title}</span>
                    <span class="meta">{fmt(post.data.pubDate)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        </aside>
      </div>
    )
  }
</Base>
