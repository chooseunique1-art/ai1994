---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.status === 'published');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });

// Share links. Built from the site's configured canonical origin (astro.config.mjs)
// rather than Astro.url, so they resolve correctly regardless of render mode.
const canonicalUrl = new URL(`/blog/${post.id}/`, Astro.site).href;
const shareText = post.data.title;
const whatsappHref = `https://wa.me/?text=${encodeURIComponent(`${shareText} ${canonicalUrl}`)}`;
const xHref = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(canonicalUrl)}`;
const facebookHref = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalUrl)}`;

// No-JS fallback for the Google Preferred Sources widget below — same
// origin as the share links above, so it tracks whatever `site` is set
// to in astro.config.mjs.
const siteHost = new URL(canonicalUrl).host;
const preferredSourceDeeplink = `https://www.google.com/preferences/source?q=${encodeURIComponent(siteHost)}`;
---

<Base
  title={post.data.title}
  description={post.data.description}
  articleCategory={post.data.region ?? 'Story'}
>
  <!--
    data-story-feed / data-story / data-sentinel: hooks for the "keep
    reading" infinite scroll below. With JS disabled this renders as a
    single ordinary article — the wrapper divs add no visible structure.
  -->
  <div class="story-feed" data-story-feed data-current-id={post.id}>
    <article class="story" data-story data-story-id={post.id}>
      {post.data.region && <span class="article-region">{post.data.region}</span>}
      <h1>{post.data.title}</h1>
      <div class="meta">
        {fmt(post.data.pubDate)}
        {post.data.sourceName && (
          <>
            <span class="dot">·</span>
            <span class="handle">{post.data.sourceName}</span>
          </>
        )}
      </div>

      <div class="share-bar" aria-label="Share this article">
        <span class="share-label">Share</span>
        <a
          class="share-btn share-btn--whatsapp"
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on WhatsApp"
        >
          <svg class="share-icon--whatsapp" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413" />
          </svg>
          WhatsApp
        </a>
        <a
          class="share-btn share-btn--x"
          href={xHref}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on X"
        >
          <svg class="share-icon--x" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
          X
        </a>
        <a
          class="share-btn share-btn--facebook"
          href={facebookHref}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on Facebook"
        >
          <svg class="share-icon--facebook" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
          </svg>
          Facebook
        </a>
        <button
          type="button"
          class="share-btn share-btn--native"
          data-native-share
          data-share-title={shareText}
          data-share-text={post.data.description}
          data-share-url={canonicalUrl}
          aria-label="More sharing options"
        >
          <svg class="share-icon--native" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3v12" />
            <path d="M7.5 7.5 12 3l4.5 4.5" />
            <path d="M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6" />
          </svg>
          <span data-native-share-label>More</span>
        </button>
      </div>

      <!--
        Google Preferred Sources widget. This is a domain-level preference,
        not a per-article action, and ideally would render once per page
        rather than once per [data-story] — but that placement (see prior
        commit) buried it below the full article, where readers never
        scrolled far enough to see it. Visibility wins: it lives here now.
        Trade-off: on a story pulled in later by the keep-reading feed
        below, this instance may render as an empty, un-hydrated div if
        Google's script doesn't rescan dynamically-inserted DOM — cosmetic
        only (no error), and only affects readers several stories deep
        into the scroll, not anyone arriving at this URL directly.
      -->
      <div class="prefer-source-bar" aria-label="Add The South Press as a preferred source on Google">
        <span class="share-label">Prefer us on Google</span>
        <div google-add-preferred-source-btn data-theme="light"></div>
        <noscript>
          <a class="share-btn" href={preferredSourceDeeplink}>Add as preferred source</a>
        </noscript>
      </div>

      {
        post.data.image && (
          <figure class="article-image">
            <img src={post.data.image} alt="" />
            {post.data.imageCredit && <figcaption>{post.data.imageCredit}</figcaption>}
          </figure>
        )
      }

      <div class="article-body">
        <Content />
      </div>

      {
        post.data.sourceName && (
          <p class="source-attribution">
            Source:{' '}
            {post.data.sourceUrl ? (
              <a href={post.data.sourceUrl} rel="noopener">
                {post.data.sourceName}
              </a>
            ) : (
              post.data.sourceName
            )}
          </p>
        )
      }
    </article>

    <div class="scroll-sentinel" data-sentinel></div>
  </div>
</Base>

<script>
  // Continuous "keep reading" scroll. Progressive enhancement only: the
  // server already rendered one full, complete article above — this script
  // just appends more of them as the reader nears the bottom, picking each
  // next story by shared region + title/description word overlap with the
  // story they just finished. Fully static-site friendly: "loading" a story
  // means fetching its own real page and lifting its [data-story] node out
  // of the response, so injected stories are pixel-identical to visiting
  // that URL directly and pick up any future markup/style changes for free.

  // "More" share button — opens the device's native share sheet (any
  // installed app, not just the three pinned platforms above). Delegated
  // on document rather than bound per-button, so it also covers stories
  // appended later by the keep-reading feed below.
  document.addEventListener('click', async (event) => {
    const trigger = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-native-share]');
    if (!trigger) return;

    const shareData = {
      title: trigger.dataset.shareTitle || document.title,
      text: trigger.dataset.shareText || '',
      url: trigger.dataset.shareUrl || location.href,
    };

    if (navigator.share) {
      try {
        await navigator.share(shareData);
      } catch (err) {
        // AbortError just means the reader closed the native sheet — not a failure.
        if ((err as Error).name !== 'AbortError') console.error('[share] native share failed', err);
      }
      return;
    }

    // No Web Share API (most desktop browsers): copy the link instead,
    // with a brief label swap to confirm it happened.
    const label = trigger.querySelector<HTMLElement>('[data-native-share-label]');
    try {
      await navigator.clipboard.writeText(shareData.url);
      if (label) {
        const original = label.textContent;
        label.textContent = 'Copied!';
        setTimeout(() => {
          label.textContent = original;
        }, 2000);
      }
    } catch (err) {
      console.error('[share] clipboard copy failed', err);
    }
  });

  const feed = document.querySelector<HTMLElement>('[data-story-feed]');
  const indexTag = document.querySelector<HTMLScriptElement>('[data-search-index]');

  type IndexedPost = {
    id: string;
    title: string;
    description: string;
    date: string;
    source: string;
    region: string | null;
    pubDate: string;
  };

  const STOPWORDS = new Set([
    'this', 'that', 'with', 'from', 'have', 'been', 'were', 'will', 'over',
    'into', 'amid', 'says', 'said', 'their', 'about', 'more', 'than', 'after',
    'before', 'while', 'during', 'which', 'what', 'when', 'where', 'would',
    'could', 'should', 'also', 'they', 'them', 'these', 'those', 'here',
    'there', 'still', 'even', 'both', 'each', 'other', 'some', 'such',
  ]);

  const significantWords = (text: string) =>
    new Set(
      text
        .toLowerCase()
        .split(/[^a-z0-9]+/)
        .filter((w) => w.length > 3 && !STOPWORDS.has(w))
    );

  const relatedness = (a: IndexedPost, b: IndexedPost) => {
    let score = 0;
    if (a.region && b.region && a.region === b.region) score += 3;

    const wa = significantWords(`${a.title} ${a.description}`);
    const wb = significantWords(`${b.title} ${b.description}`);
    for (const w of wa) if (wb.has(w)) score += 1;

    return score;
  };

  if (feed && indexTag) {
    const posts: IndexedPost[] = JSON.parse(indexTag.textContent || '[]');
    const loadedIds = new Set<string>([feed.dataset.currentId || '']);
    let chainAnchorId = feed.dataset.currentId || '';
    let loading = false;

    const pickNext = (): IndexedPost | null => {
      const anchor = posts.find((p) => p.id === chainAnchorId);
      const candidates = posts.filter((p) => !loadedIds.has(p.id));
      if (!anchor || candidates.length === 0) return null;

      return candidates
        .map((p) => ({ p, score: relatedness(anchor, p) }))
        .sort((a, b) => b.score - a.score || +new Date(b.p.pubDate) - +new Date(a.p.pubDate))[0].p;
    };

    const showEnd = () => {
      const end = document.createElement('p');
      end.className = 'end-of-feed';
      end.innerHTML = "You're all caught up — <a href=\"/\">back to the homepage</a>.";
      feed.append(end);
    };

    const sentinelObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            sentinelObserver.unobserve(entry.target);
            loadNext();
          }
        }
      },
      { rootMargin: '600px 0px 600px 0px' }
    );

    // Tracks which loaded story is the one currently in view, so the URL
    // bar and document title follow along as the reader scrolls.
    const urlObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const id = (entry.target as HTMLElement).dataset.storyId;
          const match = posts.find((p) => p.id === id);
          if (id && match) {
            history.replaceState(null, '', `/blog/${id}/`);
            document.title = match.title;
          }
        }
      },
      { rootMargin: '-45% 0px -50% 0px', threshold: 0 }
    );

    async function loadNext() {
      if (loading) return;
      loading = true;

      const next = pickNext();
      if (!next) {
        showEnd();
        loading = false;
        return;
      }
      loadedIds.add(next.id);

      const sentinel = feed!.querySelector<HTMLElement>('[data-sentinel]')!;
      const loadingEl = document.createElement('p');
      loadingEl.className = 'story-loading';
      loadingEl.textContent = 'Loading next story…';
      sentinel.before(loadingEl);

      try {
        const res = await fetch(`/blog/${next.id}/`);
        if (!res.ok) throw new Error(`fetch failed: ${res.status}`);
        const html = await res.text();
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const newStory = doc.querySelector<HTMLElement>('[data-story]');
        if (!newStory) throw new Error('story node not found in response');

        const divider = document.createElement('div');
        divider.className = 'story-divider';
        divider.innerHTML = '<span>Next story</span>';

        loadingEl.replaceWith(divider);
        divider.after(newStory);

        urlObserver.observe(newStory);
        sentinelObserver.observe(sentinel);
        chainAnchorId = next.id;
      } catch (err) {
        loadingEl.remove();
        console.error('[keep-reading] failed to load next story', err);
      } finally {
        loading = false;
      }
    }

    urlObserver.observe(document.querySelector('[data-story]')!);
    sentinelObserver.observe(feed.querySelector('[data-sentinel]')!);
  }
</script>
