---
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  articleCategory?: string;
}
const { title, description = 'Automated content pipeline test.', articleCategory } = Astro.props;

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
const searchIndex = (await getCollection('blog', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    id: post.id,
    title: post.data.title,
    description: post.data.description,
    date: fmt(post.data.pubDate),
    source: post.data.sourceName,
    region: post.data.region ?? null,
    pubDate: post.data.pubDate.toISOString(),
  }));
const searchIndexJson = JSON.stringify(searchIndex).replace(/</g, '\\u003c');

const menuRegions = [...new Set(searchIndex.map((p) => p.region).filter((r): r is string => Boolean(r)))].sort(
  (a, b) => a.localeCompare(b)
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <!-- Google Preferred Sources widget (news.google.com/swg). Async and
         scans the DOM for [google-add-preferred-source-btn] on load — see
         the prefer-source-bar in the article layout. -->
    <script async src="https://news.google.com/swg/js/v1/publisher.js"></script>
    <style is:global>
      :root {
        --ink: #16161a;
        --paper: #fbfaf7;
        --muted: #6b6b70;
        --rule: #e2e0da;
        --accent: #2f4f4f;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      .wrap {
        max-width: 30rem;
        margin: 0 auto;
        padding: 0 1.1rem 4rem;
      }

      .header-stack {
        position: sticky;
        top: 0;
        z-index: 30;
        background: var(--paper);
      }

      header.site {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-bottom: 1px solid var(--rule);
        padding: 1.1rem 1.1rem;
        margin-bottom: 0.25rem;
      }

      .brand {
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }

      .wordmark {
        font-family: ui-serif, Georgia, 'Times New Roman', serif;
        font-weight: 400;
        font-size: 1.3rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        line-height: 1;
        text-decoration: none;
        color: var(--ink);
      }

      .tagline {
        margin: 0.25rem 0 0;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.6rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent);
        white-space: nowrap;
      }

      /* ---------- Article header ---------- */

      .article-header {
        gap: 0.7rem;
        margin-bottom: 0;
        background: var(--ink);
        border-bottom-color: transparent;
      }

      .article-header .back-link,
      .article-header .wordmark-small,
      .article-header .icon-btn {
        color: var(--paper);
      }

      .article-header .article-divider {
        background: rgba(251, 250, 247, 0.25);
      }

      .article-header .article-category {
        color: rgba(251, 250, 247, 0.6);
      }

      .back-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        flex: 0 0 auto;
        color: var(--ink);
      }

      .back-link svg {
        width: 1rem;
        height: 1rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .brand-inline {
        flex: 1 1 auto;
        min-width: 0;
        flex-direction: row;
        align-items: baseline;
        gap: 0.6rem;
      }

      .wordmark-small {
        font-size: 0.85rem;
        white-space: nowrap;
      }

      .article-divider {
        flex: 0 0 auto;
        width: 1px;
        height: 0.8rem;
        background: var(--rule);
      }

      .article-category {
        flex: 1 1 auto;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
      }

      /* ---------- Header icon buttons ---------- */

      .icon-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        padding: 0;
        border: none;
        background: none;
        color: var(--ink);
        cursor: pointer;
      }

      .icon-btn svg {
        width: 1.05rem;
        height: 1.05rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.6;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .icon-btn svg.menu-icon {
        width: 1.5rem;
        height: 1.05rem;
      }

      /* ---------- Header menu ---------- */

      .menu {
        position: relative;
        flex: 0 0 auto;
      }

      .menu-panel {
        position: absolute;
        z-index: 20;
        top: calc(100% + 0.6rem);
        left: 0;
        width: min(22rem, calc(100vw - 2.4rem));
        max-height: calc(100vh - 6rem);
        overflow-y: auto;
        background: var(--paper);
        border: 1px solid var(--rule);
        box-shadow: 0 8px 24px rgba(22, 22, 26, 0.1);
        padding: 1.1rem;
      }

      .article-header .menu-panel {
        left: auto;
        right: 0;
      }

      .menu-block + .menu-block {
        margin-top: 1.1rem;
        padding-top: 1.1rem;
        border-top: 1px solid var(--rule);
      }

      .menu-label {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 0.6rem;
      }

      .menu-nav {
        display: flex;
        flex-direction: column;
      }

      .menu-nav a {
        padding: 0.5rem 0;
        text-decoration: none;
        color: var(--ink);
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.92rem;
        border-top: 1px solid var(--rule);
      }

      .menu-nav a:first-of-type {
        border-top: none;
      }

      .menu-nav a:hover,
      .menu-nav a:focus-visible {
        color: var(--accent);
      }

      .search-field {
        position: relative;
      }

      .search-field .search-icon {
        position: absolute;
        left: 0.6rem;
        top: 50%;
        transform: translateY(-50%);
        width: 0.85rem;
        height: 0.85rem;
        fill: none;
        stroke: var(--muted);
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        pointer-events: none;
      }

      .search-input {
        width: 100%;
        padding: 0.5rem 0.7rem 0.5rem 2rem;
        border: 1px solid var(--rule);
        border-radius: 2px;
        background: var(--paper);
        color: var(--ink);
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.88rem;
      }

      .search-input::placeholder {
        color: var(--muted);
      }

      .search-results {
        margin: 0.75rem 0 0;
        padding: 0;
        list-style: none;
        max-height: 40vh;
        overflow-y: auto;
      }

      .search-results li + li {
        border-top: 1px solid var(--rule);
      }

      .search-results a {
        display: block;
        padding: 0.6rem 0.1rem;
        text-decoration: none;
      }

      .search-result-title {
        display: block;
        font-family: ui-serif, Georgia, 'Times New Roman', serif;
        font-weight: 600;
        font-size: 0.9rem;
        line-height: 1.3;
        color: var(--ink);
      }

      .search-results a:hover .search-result-title,
      .search-results a:focus-visible .search-result-title {
        color: var(--accent);
      }

      .search-results .meta {
        display: block;
        margin-top: 0.25rem;
      }

      .search-empty {
        padding: 0.6rem 0.1rem;
        color: var(--muted);
        font-style: italic;
        font-size: 0.85rem;
      }

      a {
        color: inherit;
      }

      h1,
      h2,
      h3,
      .headline {
        font-family: ui-serif, Georgia, 'Times New Roman', serif;
        font-weight: 600;
        line-height: 1.28;
        margin: 0;
      }

      .meta {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.72rem;
        letter-spacing: 0.01em;
        color: var(--muted);
      }

      .meta .dot {
        margin: 0 0.35em;
        opacity: 0.6;
      }

      .meta .handle {
        color: var(--accent);
      }

      .empty {
        color: var(--muted);
        font-style: italic;
        padding: 2rem 0;
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      /* ---------- Feed (index page) ---------- */

      .chip-rail {
        display: flex;
        gap: 0.5rem;
        overflow-x: auto;
        padding: 0.25rem 0 1.1rem;
        margin-bottom: 0.25rem;
        scrollbar-width: none;
      }

      .chip-rail::-webkit-scrollbar {
        display: none;
      }

      .chip {
        flex: 0 0 auto;
        padding: 0.35rem 0.75rem;
        border: 1px solid var(--rule);
        border-radius: 3px;
        background: transparent;
        color: var(--muted);
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.8rem;
        cursor: pointer;
      }

      .chip.is-active {
        border-color: var(--accent);
        color: var(--accent);
      }

      .breaking-banner {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.6rem 0.75rem;
        margin-bottom: 1.1rem;
        background: rgba(47, 79, 79, 0.08);
        border: 1px solid var(--accent);
        border-radius: 2px;
        text-decoration: none;
        color: inherit;
      }

      .breaking-label {
        flex: 0 0 auto;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--accent);
      }

      .breaking-headline {
        font-family: ui-serif, Georgia, 'Times New Roman', serif;
        font-weight: 600;
        font-size: 0.92rem;
        color: var(--ink);
      }

      /* Lead story */
      .lead {
        display: block;
        text-decoration: none;
        color: inherit;
        padding-bottom: 1.1rem;
        border-bottom: 1px solid var(--rule);
        margin-bottom: 0.25rem;
      }

      .lead:hover .headline {
        color: var(--accent);
      }

      .lead-image {
        display: block;
        width: 100vw;
        height: auto;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        margin-bottom: 0.75rem;
        background: var(--rule);
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
      }

      /* Hero with no image: same left-rule language as sidebar rows,
         scaled up and in the accent color so it still reads as the
         lead story rather than a lesser/broken slot. */
      .lead-no-image {
        border-left: 3px solid var(--accent);
        padding-left: 1rem;
        padding-top: 0.15rem;
      }

      .eyebrow {
        display: block;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 0.35rem;
      }

      .lead .headline {
        font-size: 1.3rem;
      }

      .lead .brief {
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.95rem;
        color: #3a3a40;
        margin: 0.4rem 0 0.5rem;
        line-height: 1.4;
      }

      /* ---------- Secondary stories (below lead, left column) ---------- */

      .secondary-story {
        display: flex;
        gap: 0.75rem;
        align-items: flex-start;
        text-decoration: none;
        color: inherit;
        padding: 1rem 0;
        border-top: 1px solid var(--rule);
      }

      .secondary-story:hover .headline {
        color: var(--accent);
      }

      .secondary-thumb {
        flex: 0 0 120px;
        width: 120px;
        height: 80px;
        object-fit: cover;
        background: var(--rule);
      }

      .secondary-body {
        flex: 1;
        min-width: 0;
      }

      .secondary-body .headline {
        font-size: 1rem;
      }

      /* Hidden on mobile — only shown on desktop */
      .secondary-body .brief {
        display: none;
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.88rem;
        color: #3a3a40;
        margin: 0.3rem 0 0.3rem;
        line-height: 1.4;
      }

      .secondary-body .meta {
        margin-top: 0.25rem;
      }

      /* Ranked list */
      .ranked-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .ranked-row {
        border-top: 1px solid var(--rule);
      }

      .ranked-row[hidden] {
        display: none;
      }

      .ranked-row .story-link {
        display: block;
        text-decoration: none;
        color: inherit;
        padding: 1.1rem 0;
      }

      .ranked-row .story-link:hover .headline {
        color: var(--accent);
      }

      .story-row {
        display: flex;
        align-items: flex-start;
        gap: 0.7rem;
      }

      .story-row .thumb {
        flex: 0 0 128px;
        width: 128px;
        height: 96px;
        object-fit: cover;
        background: var(--rule);
      }

      .story-row.no-image {
        border-left: 2px solid var(--rule);
        padding-left: 0.7rem;
      }

      .story-row .story-body {
        flex: 1;
        min-width: 0;
      }

      .story-row .headline {
        font-size: 1rem;
      }

      .story-row .story-body .meta {
        margin-top: 0.35rem;
      }

      .ranked-empty {
        padding: 1.5rem 0;
        color: var(--muted);
        font-style: italic;
        font-size: 0.9rem;
        border-top: 1px solid var(--rule);
      }

      .sections-grid {
        margin-top: 1.5rem;
        padding-top: 1.1rem;
        border-top: 1px solid var(--rule);
      }

      .sections-label {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 0.75rem;
      }

      .sections-items {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem 1rem;
      }

      .section-link {
        text-align: left;
        padding: 0.4rem 0;
        border: none;
        background: none;
        color: var(--ink);
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.88rem;
        cursor: pointer;
      }

      .section-link:hover,
      .section-link.is-active {
        color: var(--accent);
      }

      /* ---------- Article page ---------- */

      .article-region {
        display: inline-block;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent);
        border: 1px solid var(--rule);
        border-radius: 2px;
        padding: 0.15em 0.5em;
        margin-bottom: 0.6rem;
      }

      /* ---------- Share bar ---------- */

      .share-bar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0.85rem 0 1.1rem;
      }

      .share-label {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--muted);
        margin-right: 0.1rem;
      }

      /* Icon-only: WhatsApp/X/Facebook/More/Google all need to sit in one
         row without wrapping the page's width, so there's no text label
         here — aria-label carries the accessible name instead. */
      .share-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.15rem;
        height: 2.15rem;
        padding: 0;
        border: 1px solid var(--rule);
        border-radius: 3px;
        background: transparent;
        color: var(--ink);
        text-decoration: none;
        line-height: 1;
      }

      .share-btn:hover,
      .share-btn:focus-visible {
        border-color: var(--accent);
        color: var(--accent);
      }

      .share-btn svg {
        width: 1.15rem;
        height: 1.15rem;
        flex: 0 0 auto;
      }

      /* Brief confirmation state for the "More" button's clipboard
         fallback (icon swaps to a checkmark via JS; this just colors
         the button to match while that's showing). */
      .share-btn--copied,
      .share-btn--copied:hover,
      .share-btn--copied:focus-visible {
        border-color: var(--accent);
        color: var(--accent);
      }

      /* <noscript> text fallback for the Google button — the only
         .share-btn that still needs to show words, since there's no
         icon to fall back to without JS. */
      .share-btn--google-fallback {
        width: auto;
        height: auto;
        padding: 0.32rem 0.7rem;
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.8rem;
      }

      /* Brand-colored marks — the one deliberate spot of color on an
         otherwise monochrome page, so the row reads at a glance instead
         of blending into the meta text around it. */
      .share-icon--whatsapp {
        fill: #25d366;
      }

      .share-icon--x {
        fill: #0a0a0a;
      }

      .share-icon--facebook {
        fill: #1877f2;
      }

      .share-btn--whatsapp:hover,
      .share-btn--whatsapp:focus-visible {
        border-color: #25d366;
        color: #25d366;
      }

      .share-btn--x:hover,
      .share-btn--x:focus-visible {
        border-color: #0a0a0a;
        color: #0a0a0a;
      }

      .share-btn--facebook:hover,
      .share-btn--facebook:focus-visible {
        border-color: #1877f2;
        color: #1877f2;
      }

      /* Generic "share to anywhere" button — a system action, not a
         platform, so it stays monoline/ink like the rest of the site's
         UI chrome instead of taking a brand color. */
      .share-btn--native {
        font: inherit;
        cursor: pointer;
      }

      .share-icon--native {
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      article h1 {
        font-size: clamp(1.5rem, 5vw, 1.9rem);
        margin-bottom: 0.6rem;
      }

      .article-image {
        margin: 1rem -1.1rem;
      }

      /* Capped, cropped consistently regardless of the source photo's
         native proportions — a tall portrait shot (common from social
         posts) would otherwise stretch to fill the full-bleed width and
         end up several screens tall on mobile, burying the article text.
         object-fit: cover keeps the image intact-looking (center-cropped,
         no distortion) at a predictable height. */
      .article-image img {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        background: var(--rule);
      }

      .article-image figcaption {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.68rem;
        color: var(--muted);
        padding: 0.35rem 1.1rem 0;
      }

      .article-body {
        font-family: ui-serif, Georgia, 'Times New Roman', serif;
        font-size: 1.05rem;
        line-height: 1.65;
        color: #232326;
      }

      .article-body p {
        margin: 0 0 1rem;
      }

      .article-body a {
        color: var(--accent);
      }

      .source-attribution {
        margin-top: 2.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--rule);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.78rem;
        color: var(--muted);
        word-break: break-word;
      }

      .source-attribution a {
        color: var(--accent);
      }

      /* ---------- Keep-reading infinite scroll ---------- */

      .story + .story-divider {
        margin-top: 3rem;
      }

      .story-divider {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 3rem 0 2rem;
        color: var(--muted);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.7rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .story-divider::before,
      .story-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--rule);
      }

      .story-loading {
        margin: 3rem 0;
        color: var(--muted);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.78rem;
        text-align: center;
      }

      .end-of-feed {
        margin: 3rem 0 1rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--rule);
        color: var(--muted);
        font-size: 0.9rem;
        text-align: center;
      }

      .end-of-feed a {
        color: var(--accent);
      }

      /* ---------- Desktop (>=1024px) — BBC-style grid ---------- */

      @media (min-width: 1024px) {
        .wrap {
          max-width: 1200px;
          padding: 0 2rem 4rem;
        }

        .menu-panel {
          width: 24rem;
        }

        header.site {
          padding-left: 2rem;
          padding-right: 2rem;
        }

        /* Article pages stay narrow */
        .story-feed {
          max-width: 42rem;
          margin: 0 auto;
        }

        .chip-rail {
          overflow-x: visible;
          flex-wrap: wrap;
        }

        /* BBC-style 2-column grid: lead-col left, sidebar right */
        .content-grid {
          display: grid;
          grid-template-columns: 1fr 380px;
          column-gap: 2.5rem;
          align-items: start;
          border-top: 3px solid var(--ink);
          padding-top: 1.25rem;
          margin-top: 0.25rem;
        }

        /* Left column wrapper gets the dividing border */
        .lead-col {
          border-right: 1px solid var(--rule);
          padding-right: 2.5rem;
        }

        /* Lead: no border (it's on lead-col now) */
        .lead {
          border-bottom: 1px solid var(--rule);
          border-right: none;
          padding-right: 0;
          padding-bottom: 1.1rem;
          margin-bottom: 0;
        }

        /* Lead image: contained within column, no full-bleed */
        .lead-image {
          position: static;
          width: 100%;
          height: 360px;
          aspect-ratio: auto;
          margin-left: 0;
          margin-right: 0;
          left: auto;
          right: auto;
          margin-bottom: 1rem;
        }

        .lead .headline {
          font-size: 1.9rem;
        }

        .lead .brief {
          font-size: 1rem;
        }

        /* Secondary stories: show brief + bigger thumbs on desktop */
        .secondary-body .brief {
          display: block;
          font-size: 0.92rem;
        }

        .secondary-thumb {
          flex: 0 0 150px;
          width: 150px;
          height: 100px;
        }

        .secondary-body .headline {
          font-size: 1.1rem;
        }

        /* Sidebar flows naturally */
        .sidebar {
          /* natural grid column 2 */
        }

        /* Tighter story rows in sidebar */
        .ranked-row .story-link {
          padding: 0.75rem 0;
        }

        .story-row .thumb {
          flex: 0 0 72px;
          width: 72px;
          height: 54px;
        }

        .story-row .headline {
          font-size: 0.92rem;
        }

        /* Article body image: cap height on desktop too, don't let it
           dominate the reading column */
        .article-image img {
          aspect-ratio: 16 / 9;
          max-height: 480px;
        }
      }
    </style>
  </head>
  <body>
    <div class="header-stack">
        {
          articleCategory ? (
            <header class="site article-header">
              <a href="/" class="back-link" aria-label="Back to home">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <polyline points="15 6 9 12 15 18" />
                </svg>
              </a>

              <div class="brand brand-inline">
                <a href="/" class="wordmark wordmark-small">
                  The South Press
                </a>
                <span class="article-divider" aria-hidden="true" />
                <span class="article-category">{articleCategory}</span>
              </div>

              <div class="menu" data-menu>
                <button
                  type="button"
                  class="icon-btn"
                  data-menu-toggle
                  aria-expanded="false"
                  aria-label="Open menu"
                >
                  <svg class="menu-icon" viewBox="0 0 34 24" aria-hidden="true">
                    <line x1="2" y1="5" x2="14" y2="5" />
                    <line x1="2" y1="12" x2="14" y2="12" />
                    <line x1="2" y1="19" x2="14" y2="19" />
                    <circle cx="23" cy="10" r="6" />
                    <line x1="27.5" y1="14.5" x2="32" y2="19" />
                  </svg>
                </button>

                <div class="menu-panel" data-menu-panel hidden>
                  <div class="menu-block">
                    <div class="menu-label">Search</div>
                    <div class="search-field">
                      <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                      </svg>
                      <input
                        type="search"
                        class="search-input"
                        placeholder="Search headlines…"
                        aria-label="Search headlines"
                        autocomplete="off"
                        data-search-input
                      />
                    </div>
                    <ul class="search-results" data-search-results hidden />
                  </div>

                  <div class="menu-block menu-nav">
                    <div class="menu-label">Sections</div>
                    <a href="/">Home</a>
                    {menuRegions.map((region) => (
                      <a href={`/?region=${encodeURIComponent(region)}`}>{region}</a>
                    ))}
                  </div>
                </div>
              </div>
            </header>
        ) : (
          <header class="site">
            <div class="menu" data-menu>
              <button type="button" class="icon-btn" data-menu-toggle aria-expanded="false" aria-label="Open menu">
                <svg class="menu-icon" viewBox="0 0 34 24" aria-hidden="true">
                  <line x1="2" y1="5" x2="14" y2="5" />
                  <line x1="2" y1="12" x2="14" y2="12" />
                  <line x1="2" y1="19" x2="14" y2="19" />
                  <circle cx="23" cy="10" r="6" />
                  <line x1="27.5" y1="14.5" x2="32" y2="19" />
                </svg>
              </button>

              <div class="menu-panel" data-menu-panel hidden>
                <div class="menu-block">
                  <div class="menu-label">Search</div>
                  <div class="search-field">
                    <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
                      <circle cx="11" cy="11" r="7" />
                      <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>
                    <input
                      type="search"
                      class="search-input"
                      placeholder="Search headlines…"
                      aria-label="Search headlines"
                      autocomplete="off"
                      data-search-input
                    />
                  </div>
                  <ul class="search-results" data-search-results hidden />
                </div>

                <div class="menu-block menu-nav">
                  <div class="menu-label">Sections</div>
                  <a href="/">Home</a>
                  {menuRegions.map((region) => (
                    <a href={`/?region=${encodeURIComponent(region)}`}>{region}</a>
                  ))}
                </div>
              </div>
            </div>

            <div class="brand">
              <a href="/" class="wordmark">
                The South Press
              </a>
              <p class="tagline">perspective that matters</p>
            </div>
          </header>
        )
      }
    </div>
    <div class="wrap">
      <slot />
    </div>

    <script type="application/json" data-search-index set:html={searchIndexJson} />

    <script>
      const menu = document.querySelector<HTMLElement>('[data-menu]');
      const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menuPanel = document.querySelector<HTMLElement>('[data-menu-panel]');
      const input = document.querySelector<HTMLInputElement>('[data-search-input]');
      const results = document.querySelector<HTMLUListElement>('[data-search-results]');
      const indexTag = document.querySelector<HTMLScriptElement>('[data-search-index]');

      type SearchPost = { id: string; title: string; description: string; date: string; source: string };

      if (menu && menuToggle && menuPanel) {
        const closeMenu = () => {
          menuPanel.hidden = true;
          menuToggle.setAttribute('aria-expanded', 'false');
          if (results) {
            results.hidden = true;
            results.innerHTML = '';
          }
          if (input) input.value = '';
        };

        menuToggle.addEventListener('click', () => {
          const willOpen = menuPanel.hidden;
          menuPanel.hidden = !willOpen;
          menuToggle.setAttribute('aria-expanded', String(willOpen));
          if (willOpen) input?.focus();
        });

        document.addEventListener('click', (event) => {
          if (!menu.contains(event.target as Node)) closeMenu();
        });

        menu.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            closeMenu();
            menuToggle.focus();
          }
        });
      }

      if (input && results && indexTag) {
        const posts: SearchPost[] = JSON.parse(indexTag.textContent || '[]');
        const MAX_RESULTS = 8;

        const render = (matches: SearchPost[], query: string) => {
          results.innerHTML = '';

          if (matches.length === 0) {
            const empty = document.createElement('li');
            empty.className = 'search-empty';
            empty.textContent = `No headlines match "${query}".`;
            results.append(empty);
            return;
          }

          for (const post of matches.slice(0, MAX_RESULTS)) {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = `/blog/${post.id}/`;

            const titleEl = document.createElement('span');
            titleEl.className = 'search-result-title';
            titleEl.textContent = post.title;

            const metaEl = document.createElement('span');
            metaEl.className = 'meta';
            metaEl.textContent = `${post.date} · ${post.source}`;

            a.append(titleEl, metaEl);
            li.append(a);
            results.append(li);
          }
        };

        input.addEventListener('input', () => {
          const query = input.value.trim().toLowerCase();

          if (!query) {
            results.hidden = true;
            results.innerHTML = '';
            return;
          }

          const matches = posts.filter(
            (post) =>
              post.title.toLowerCase().includes(query) || post.description.toLowerCase().includes(query)
          );

          render(matches, input.value.trim());
          results.hidden = false;
        });

        input.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowDown' && !results.hidden) {
            event.preventDefault();
            results.querySelector('a')?.focus();
          }
        });

        input.addEventListener('focus', () => {
          if (input.value.trim() && results.childElementCount > 0) {
            results.hidden = false;
          }
        });
      }
    </script>
  </body>
</html>
