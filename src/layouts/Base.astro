---
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Automated content pipeline test.' } = Astro.props;

// Site-wide post index. Built once at build time from every published post
// (not just what any one page happens to render). Two features share it:
// the header search box below, and the "keep reading" infinite scroll on
// article pages (src/pages/blog/[...slug].astro), which uses region +
// title/description overlap to pick what loads next.
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
const searchIndex = (await getCollection('blog', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    id: post.id,
    title: post.data.title,
    description: post.data.description,
    date: fmt(post.data.pubDate),
    source: post.data.sourceName,
    region: post.data.region ?? null,
    pubDate: post.data.pubDate.toISOString(),
  }));
// Guard against a stray "</script>" inside post text prematurely closing the tag.
const searchIndexJson = JSON.stringify(searchIndex).replace(/</g, '\\u003c');

// Header menu: same regions the homepage's chip rail uses, off the index
// already built above — no extra query. Links carry ?region= so the
// homepage can pick up the filter after navigating there from any page.
const menuRegions = [...new Set(searchIndex.map((p) => p.region).filter((r): r is string => Boolean(r)))].sort(
  (a, b) => a.localeCompare(b)
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <style is:global>
      :root {
        --ink: #16161a;
        --paper: #fbfaf7;
        --muted: #6b6b70;
        --rule: #e2e0da;
        --accent: #2f4f4f;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      .wrap {
        max-width: 30rem;
        margin: 0 auto;
        padding: 0 1.1rem 4rem;
      }

      header.site {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-bottom: 1px solid var(--rule);
        padding: 1.1rem 0;
        margin-bottom: 0.25rem;
      }

      .brand {
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }

      /* Restrained nameplate: upright serif wordmark (same face as the
         headlines below it, normal weight — no italic, no rule), with a
         quiet lowercase sans tagline directly underneath. */
      .wordmark {
        font-family: ui-serif, Georgia, 'Times New Roman', serif;
        font-weight: 400;
        font-size: 1.3rem;
        line-height: 1;
        text-decoration: none;
        color: var(--ink);
      }

      .tagline {
        margin: 0;
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.78rem;
        color: var(--muted);
        white-space: nowrap;
      }

      /* ---------- Header icon buttons (menu + search) ---------- */

      .icon-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        padding: 0;
        border: none;
        background: none;
        color: var(--ink);
        cursor: pointer;
      }

      .icon-btn svg {
        width: 1.05rem;
        height: 1.05rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.6;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      /* ---------- Header menu ---------- */

      .menu {
        position: relative;
        flex: 0 0 auto;
      }

      .menu-panel {
        position: absolute;
        z-index: 20;
        top: calc(100% + 0.4rem);
        left: 0;
        min-width: 11rem;
        background: var(--paper);
        border: 1px solid var(--rule);
        box-shadow: 0 4px 14px rgba(22, 22, 26, 0.08);
        padding: 0.4rem 0;
      }

      .menu-panel a {
        display: block;
        padding: 0.5rem 0.9rem;
        text-decoration: none;
        color: var(--ink);
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.88rem;
      }

      .menu-panel a:hover,
      .menu-panel a:focus-visible {
        color: var(--accent);
        background: rgba(47, 79, 79, 0.06);
      }

      /* ---------- Header search ---------- */

      .search {
        position: relative;
        flex: 0 0 auto;
        margin-left: auto;
      }

      .search-box {
        position: absolute;
        z-index: 20;
        top: calc(100% + 0.4rem);
        right: 0;
        width: 14rem;
      }

      .search-box .search-icon {
        position: absolute;
        left: 0.55rem;
        top: 50%;
        transform: translateY(-50%);
        width: 0.85rem;
        height: 0.85rem;
        fill: none;
        stroke: var(--muted);
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        pointer-events: none;
      }

      .search-input {
        width: 100%;
        padding: 0.45rem 0.6rem 0.45rem 1.9rem;
        border: 1px solid var(--rule);
        border-radius: 2px;
        background: var(--paper);
        color: var(--ink);
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.85rem;
        box-shadow: 0 4px 14px rgba(22, 22, 26, 0.08);
      }

      .search-input::placeholder {
        color: var(--muted);
      }

      .search-results {
        position: absolute;
        z-index: 20;
        top: calc(100% + 0.4rem);
        right: 0;
        width: max(100%, 20rem);
        max-width: min(24rem, 90vw);
        max-height: 70vh;
        overflow-y: auto;
        margin: 0;
        padding: 0;
        list-style: none;
        background: var(--paper);
        border: 1px solid var(--rule);
        box-shadow: 0 4px 14px rgba(22, 22, 26, 0.08);
      }

      .search-results li + li {
        border-top: 1px solid var(--rule);
      }

      .search-results a {
        display: block;
        padding: 0.6rem 0.75rem;
        text-decoration: none;
      }

      .search-results a:hover,
      .search-results a:focus-visible {
        background: var(--rule);
      }

      .search-result-title {
        display: block;
        font-family: ui-serif, Georgia, 'Times New Roman', serif;
        font-weight: 600;
        font-size: 0.9rem;
        line-height: 1.3;
        color: var(--ink);
      }

      .search-results .meta {
        display: block;
        margin-top: 0.25rem;
      }

      .search-empty {
        padding: 0.75rem;
        color: var(--muted);
        font-style: italic;
        font-size: 0.85rem;
      }

      a {
        color: inherit;
      }

      /* Headlines: serif. Metadata: mono. Body copy of a story: sans. */
      h1,
      h2,
      h3,
      .headline {
        font-family: ui-serif, Georgia, 'Times New Roman', serif;
        font-weight: 600;
        line-height: 1.28;
        margin: 0;
      }

      .meta {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.72rem;
        letter-spacing: 0.01em;
        color: var(--muted);
      }

      .meta .dot {
        margin: 0 0.35em;
        opacity: 0.6;
      }

      .meta .handle {
        color: var(--accent);
      }

      .empty {
        color: var(--muted);
        font-style: italic;
        padding: 2rem 0;
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      /* ---------- Feed (index page) ---------- */

      .chip-rail {
        display: flex;
        gap: 0.5rem;
        overflow-x: auto;
        padding: 0.25rem 0 1.1rem;
        margin-bottom: 0.25rem;
        scrollbar-width: none;
      }

      .chip-rail::-webkit-scrollbar {
        display: none;
      }

      .chip {
        flex: 0 0 auto;
        padding: 0.35rem 0.75rem;
        border: 1px solid var(--rule);
        border-radius: 3px;
        background: transparent;
        color: var(--muted);
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.8rem;
        cursor: pointer;
      }

      .chip.is-active {
        border-color: var(--accent);
        color: var(--accent);
      }

      .breaking-banner {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.6rem 0.75rem;
        margin-bottom: 1.1rem;
        background: rgba(47, 79, 79, 0.08);
        border: 1px solid var(--accent);
        border-radius: 2px;
        text-decoration: none;
        color: inherit;
      }

      .breaking-label {
        flex: 0 0 auto;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--accent);
      }

      .breaking-headline {
        font-family: ui-serif, Georgia, 'Times New Roman', serif;
        font-weight: 600;
        font-size: 0.92rem;
        color: var(--ink);
      }

      /* Lead story */
      .lead {
        display: block;
        text-decoration: none;
        color: inherit;
        padding-bottom: 1.1rem;
        border-bottom: 1px solid var(--rule);
        margin-bottom: 0.25rem;
      }

      .lead:hover .headline {
        color: var(--accent);
      }

      .lead-image {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        margin-bottom: 0.75rem;
        background: var(--rule);
      }

      .eyebrow {
        display: block;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 0.35rem;
      }

      .lead .headline {
        font-size: 1.3rem;
      }

      .lead .brief {
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.95rem;
        color: #3a3a40;
        margin: 0.4rem 0 0.5rem;
        line-height: 1.4;
      }

      /* Ranked list */
      .ranked-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .ranked-row {
        border-top: 1px solid var(--rule);
      }

      .ranked-row[hidden] {
        display: none;
      }

      .ranked-row .story-link {
        display: block;
        text-decoration: none;
        color: inherit;
        padding: 1.1rem 0;
      }

      .ranked-row .story-link:hover .headline {
        color: var(--accent);
      }

      .story-row {
        display: flex;
        align-items: flex-start;
        gap: 0.7rem;
      }

      .story-row .thumb {
        flex: 0 0 128px;
        width: 128px;
        height: 96px;
        object-fit: cover;
        background: var(--rule);
      }

      /* No thumbnail: a thin left rule anchors the row instead */
      .story-row.no-image {
        border-left: 2px solid var(--rule);
        padding-left: 0.7rem;
      }

      .story-row .story-body {
        flex: 1;
        min-width: 0;
      }

      .story-row .headline {
        font-size: 1rem;
      }

      .story-row .story-body .meta {
        margin-top: 0.35rem;
      }

      .ranked-empty {
        padding: 1.5rem 0;
        color: var(--muted);
        font-style: italic;
        font-size: 0.9rem;
        border-top: 1px solid var(--rule);
      }

      /* Section navigation, echoed at the bottom of a long list */
      .sections-grid {
        margin-top: 1.5rem;
        padding-top: 1.1rem;
        border-top: 1px solid var(--rule);
      }

      .sections-label {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 0.75rem;
      }

      .sections-items {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem 1rem;
      }

      .section-link {
        text-align: left;
        padding: 0.4rem 0;
        border: none;
        background: none;
        color: var(--ink);
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.88rem;
        cursor: pointer;
      }

      .section-link:hover,
      .section-link.is-active {
        color: var(--accent);
      }

      /* ---------- Article page ---------- */

      .article-region {
        display: inline-block;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent);
        border: 1px solid var(--rule);
        border-radius: 2px;
        padding: 0.15em 0.5em;
        margin-bottom: 0.6rem;
      }

      article h1 {
        font-size: clamp(1.5rem, 5vw, 1.9rem);
        margin-bottom: 0.6rem;
      }

      .article-image {
        margin: 1rem -1.1rem;
      }

      .article-image img {
        display: block;
        width: 100%;
        height: auto;
      }

      .article-image figcaption {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.68rem;
        color: var(--muted);
        padding: 0.35rem 1.1rem 0;
      }

      .article-body {
        font-family: ui-serif, Georgia, 'Times New Roman', serif;
        font-size: 1.05rem;
        line-height: 1.65;
        color: #232326;
      }

      .article-body p {
        margin: 0 0 1rem;
      }

      .article-body a {
        color: var(--accent);
      }

      .source-attribution {
        margin-top: 2.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--rule);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.78rem;
        color: var(--muted);
        word-break: break-word;
      }

      .source-attribution a {
        color: var(--accent);
      }

      /* ---------- Keep-reading infinite scroll (article page) ---------- */

      .story + .story-divider {
        margin-top: 3rem;
      }

      .story-divider {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 3rem 0 2rem;
        color: var(--muted);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.7rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .story-divider::before,
      .story-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--rule);
      }

      .story-loading {
        margin: 3rem 0;
        color: var(--muted);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.78rem;
        text-align: center;
      }

      .end-of-feed {
        margin: 3rem 0 1rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--rule);
        color: var(--muted);
        font-size: 0.9rem;
        text-align: center;
      }

      .end-of-feed a {
        color: var(--accent);
      }

      /* ---------- Desktop (>=1024px) ---------- */

      @media (min-width: 1024px) {
        .wrap {
          max-width: 1200px;
          padding: 0 2rem 4rem;
        }

        /* More breathing room once the header isn't fighting a narrow viewport. */
        .search-box {
          width: 18rem;
        }

        /* No sidebar in this layout — cap the reading width on the
           homepage's ranked list and on article pages instead of letting
           either stretch across the full 1200px wrap. */
        .home,
        .story-feed {
          max-width: 42rem;
          margin: 0 auto;
        }

        .chip-rail {
          overflow-x: visible;
          flex-wrap: wrap;
        }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="site">
        <div class="menu" data-menu>
          <button type="button" class="icon-btn" data-menu-toggle aria-expanded="false" aria-label="Open menu">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <line x1="3" y1="7" x2="21" y2="7" />
              <line x1="3" y1="12" x2="21" y2="12" />
              <line x1="3" y1="17" x2="21" y2="17" />
            </svg>
          </button>
          <div class="menu-panel" data-menu-panel hidden>
            <a href="/">Home</a>
            {menuRegions.map((region) => (
              <a href={`/?region=${encodeURIComponent(region)}`}>{region}</a>
            ))}
          </div>
        </div>

        <div class="brand">
          <a href="/" class="wordmark">Owaya</a>
          <p class="tagline">perspectives that matter</p>
        </div>

        <div class="search" data-search>
          <button type="button" class="icon-btn" data-search-toggle aria-expanded="false" aria-label="Open search">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
          </button>

          <div class="search-box" data-search-box hidden>
            <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input
              type="search"
              class="search-input"
              placeholder="Search…"
              aria-label="Search headlines"
              autocomplete="off"
              data-search-input
            />
            <ul class="search-results" data-search-results hidden></ul>
          </div>
        </div>
      </header>
      <slot />
    </div>

    <script type="application/json" data-search-index set:html={searchIndexJson} />

    <script>
      // --- Header menu: hamburger toggles a small dropdown of Home + regions ---
      const menu = document.querySelector<HTMLElement>('[data-menu]');
      const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menuPanel = document.querySelector<HTMLElement>('[data-menu-panel]');

      if (menu && menuToggle && menuPanel) {
        const closeMenu = () => {
          menuPanel.hidden = true;
          menuToggle.setAttribute('aria-expanded', 'false');
        };

        menuToggle.addEventListener('click', () => {
          const willOpen = menuPanel.hidden;
          menuPanel.hidden = !willOpen;
          menuToggle.setAttribute('aria-expanded', String(willOpen));
        });

        document.addEventListener('click', (event) => {
          if (!menu.contains(event.target as Node)) closeMenu();
        });

        menuPanel.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            closeMenu();
            menuToggle.focus();
          }
        });
      }

      // --- Header search: icon expands into the search box on click ---
      const container = document.querySelector<HTMLElement>('[data-search]');
      const searchToggle = document.querySelector<HTMLButtonElement>('[data-search-toggle]');
      const searchBox = document.querySelector<HTMLElement>('[data-search-box]');
      const input = document.querySelector<HTMLInputElement>('[data-search-input]');
      const results = document.querySelector<HTMLUListElement>('[data-search-results]');
      const indexTag = document.querySelector<HTMLScriptElement>('[data-search-index]');

      type SearchPost = { id: string; title: string; description: string; date: string; source: string };

      if (container && searchToggle && searchBox && input && results && indexTag) {
        const posts: SearchPost[] = JSON.parse(indexTag.textContent || '[]');
        const MAX_RESULTS = 8;

        const render = (matches: SearchPost[], query: string) => {
          results.innerHTML = '';

          if (matches.length === 0) {
            const empty = document.createElement('li');
            empty.className = 'search-empty';
            empty.textContent = `No headlines match "${query}".`;
            results.append(empty);
            return;
          }

          for (const post of matches.slice(0, MAX_RESULTS)) {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = `/blog/${post.id}/`;

            const titleEl = document.createElement('span');
            titleEl.className = 'search-result-title';
            titleEl.textContent = post.title;

            const metaEl = document.createElement('span');
            metaEl.className = 'meta';
            metaEl.textContent = `${post.date} · ${post.source}`;

            a.append(titleEl, metaEl);
            li.append(a);
            results.append(li);
          }
        };

        const closeResults = () => {
          results.hidden = true;
          results.innerHTML = '';
        };

        const closeSearch = () => {
          searchBox.hidden = true;
          searchToggle.setAttribute('aria-expanded', 'false');
          closeResults();
          input.value = '';
        };

        searchToggle.addEventListener('click', () => {
          if (searchBox.hidden) {
            searchBox.hidden = false;
            searchToggle.setAttribute('aria-expanded', 'true');
            input.focus();
          } else {
            closeSearch();
          }
        });

        input.addEventListener('input', () => {
          const query = input.value.trim().toLowerCase();

          if (!query) {
            closeResults();
            return;
          }

          const matches = posts.filter(
            (post) =>
              post.title.toLowerCase().includes(query) || post.description.toLowerCase().includes(query)
          );

          render(matches, input.value.trim());
          results.hidden = false;
        });

        input.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            closeSearch();
            searchToggle.focus();
          } else if (event.key === 'ArrowDown' && !results.hidden) {
            event.preventDefault();
            results.querySelector('a')?.focus();
          }
        });

        input.addEventListener('focus', () => {
          if (input.value.trim() && results.childElementCount > 0) {
            results.hidden = false;
          }
        });

        document.addEventListener('click', (event) => {
          if (!container.contains(event.target as Node)) closeSearch();
        });
      }
    </script>
  </body>
</html>
