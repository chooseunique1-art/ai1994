---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Automated content pipeline test.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <style is:global>
      :root {
        --ink: #16161a;
        --paper: #fbfaf7;
        --muted: #6b6b70;
        --rule: #e2e0da;
        --accent: #2f4f4f;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      .wrap {
        max-width: 30rem;
        margin: 0 auto;
        padding: 0 1.1rem 4rem;
      }

      header.site {
        border-bottom: 1px solid var(--rule);
        padding: 1.1rem 0;
        margin-bottom: 0.25rem;
      }

      header.site a {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.8rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--ink);
      }

      a {
        color: inherit;
      }

      /* Headlines: serif. Metadata: mono. Body copy of a story: sans. */
      h1,
      h2,
      h3,
      .headline {
        font-family: ui-serif, Georgia, 'Times New Roman', serif;
        font-weight: 600;
        line-height: 1.28;
        margin: 0;
      }

      .meta {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.72rem;
        letter-spacing: 0.01em;
        color: var(--muted);
      }

      .meta .dot {
        margin: 0 0.35em;
        opacity: 0.6;
      }

      .meta .handle {
        color: var(--accent);
      }

      .empty {
        color: var(--muted);
        font-style: italic;
        padding: 2rem 0;
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      /* ---------- Feed (index page) ---------- */

      .feed {
        display: flex;
        flex-direction: column;
      }

      .story-link {
        display: block;
        text-decoration: none;
        color: inherit;
        padding: 1.1rem 0;
        border-top: 1px solid var(--rule);
      }

      .story-link:hover .headline {
        color: var(--accent);
      }

      /* Top story */
      .story-link.top-story {
        border-top: none;
      }

      .top-story .top-image {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        margin-bottom: 0.75rem;
        background: var(--rule);
      }

      .top-story .region-label {
        display: block;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 0.35rem;
      }

      .top-story .headline {
        font-size: 1.3rem;
      }

      .top-story .brief {
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.95rem;
        color: #3a3a40;
        margin: 0.4rem 0 0.5rem;
        line-height: 1.4;
      }

      /* Ordinary story row */
      .story-row {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
      }

      .story-row .thumb {
        flex: 0 0 108px;
        width: 108px;
        height: 82px;
        object-fit: cover;
        background: var(--rule);
      }

      .story-row .story-body {
        flex: 1;
        min-width: 0;
      }

      .story-row .headline {
        font-size: 1rem;
      }

      .story-row .story-body .meta {
        margin-top: 0.35rem;
      }

      /* No-image story: thin left rule fills the thumbnail's visual slot */
      .story-row.no-image {
        border-left: 2px solid var(--rule);
        padding-left: 0.75rem;
      }

      .story-row.no-image .region-label {
        display: block;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 0.3rem;
      }

      /* ---------- Article page ---------- */

      .article-region {
        display: inline-block;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent);
        border: 1px solid var(--rule);
        border-radius: 2px;
        padding: 0.15em 0.5em;
        margin-bottom: 0.6rem;
      }

      article h1 {
        font-size: clamp(1.5rem, 5vw, 1.9rem);
        margin-bottom: 0.6rem;
      }

      .article-image {
        margin: 1rem -1.1rem;
      }

      .article-image img {
        display: block;
        width: 100%;
        height: auto;
      }

      .article-image figcaption {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.68rem;
        color: var(--muted);
        padding: 0.35rem 1.1rem 0;
      }

      .article-body {
        font-family: ui-serif, Georgia, 'Times New Roman', serif;
        font-size: 1.05rem;
        line-height: 1.65;
        color: #232326;
      }

      .article-body p {
        margin: 0 0 1rem;
      }

      .article-body a {
        color: var(--accent);
      }

      .source-attribution {
        margin-top: 2.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--rule);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.78rem;
        color: var(--muted);
        word-break: break-word;
      }

      .source-attribution a {
        color: var(--accent);
      }

      /* ---------- Desktop feed + sidebar (>=1024px) ---------- */
      /* Everything in this section is inert below the breakpoint: .sidebar
         is hidden by default and .beyond-cap only takes effect inside the
         media query, so the mobile layout above is untouched. */

      .sidebar {
        display: none;
      }

      @media (min-width: 1024px) {
        .wrap {
          max-width: 1200px;
          padding: 0 2rem 4rem;
        }

        .content {
          display: flex;
          align-items: flex-start;
          gap: 3rem;
        }

        .feed {
          flex: 1 1 680px;
          max-width: 680px;
          min-width: 0;
        }

        /* Main column shows the top story + 11 rows; the rest live in the
           sidebar's "More headlines" list instead. */
        .feed .story-link.beyond-cap {
          display: none;
        }

        .sidebar {
          display: block;
          flex: 0 0 320px;
          width: 320px;
          position: sticky;
          top: 2rem;
        }

        .sidebar-section + .sidebar-section {
          margin-top: 2rem;
        }

        .sidebar-heading {
          font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
          font-size: 0.72rem;
          letter-spacing: 0.1em;
          text-transform: uppercase;
          color: var(--muted);
          margin: 0 0 0.75rem;
          padding-bottom: 0.5rem;
          border-bottom: 1px solid var(--rule);
        }

        .region-list,
        .headline-list {
          list-style: none;
          margin: 0;
          padding: 0;
        }

        .region-list li + li,
        .headline-list li + li {
          margin-top: 0.6rem;
        }

        .region-list a {
          text-decoration: none;
          font-size: 0.9rem;
        }

        .region-list a:hover {
          color: var(--accent);
        }

        .headline-list a {
          display: block;
          text-decoration: none;
          padding-top: 0.6rem;
          border-top: 1px solid var(--rule);
        }

        .headline-list li:first-child a {
          border-top: none;
          padding-top: 0;
        }

        .headline-list a:hover .headline-text {
          color: var(--accent);
        }

        .headline-list .headline-text {
          display: block;
          font-family: ui-serif, Georgia, 'Times New Roman', serif;
          font-weight: 600;
          font-size: 0.92rem;
          line-height: 1.3;
        }

        .headline-list .meta {
          display: block;
          margin-top: 0.25rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="site">
        <a href="/">ai1994</a>
      </header>
      <slot />
    </div>
  </body>
</html>
