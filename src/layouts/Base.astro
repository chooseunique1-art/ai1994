---
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  // Set on article pages only. Swaps the homepage's hamburger+search
  // header for a back-to-home + category header instead, and shows the
  // reading-progress rule beneath it.
  articleCategory?: string;
}
const { title, description = 'Automated content pipeline test.', articleCategory } = Astro.props;

// Site-wide post index. Built once at build time from every published post
// (not just what any one page happens to render). Two features share it:
// the header search box below, and the "keep reading" infinite scroll on
// article pages (src/pages/blog/[...slug].astro), which uses region +
// title/description overlap to pick what loads next.
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
const searchIndex = (await getCollection('blog', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    id: post.id,
    title: post.data.title,
    description: post.data.description,
    date: fmt(post.data.pubDate),
    source: post.data.sourceName,
    region: post.data.region ?? null,
    pubDate: post.data.pubDate.toISOString(),
  }));
// Guard against a stray "</script>" inside post text prematurely closing the tag.
const searchIndexJson = JSON.stringify(searchIndex).replace(/</g, '\\u003c');

// Header menu: same regions the homepage's chip rail uses, off the index
// already built above — no extra query. Links carry ?region= so the
// homepage can pick up the filter after navigating there from any page.
const menuRegions = [...new Set(searchIndex.map((p) => p.region).filter((r): r is string => Boolean(r)))].sort(
  (a, b) => a.localeCompare(b)
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <style is:global>
      :root {
        --ink: #16161a;
        --paper: #fbfaf7;
        --muted: #6b6b70;
        --rule: #e2e0da;
        --accent: #2f4f4f;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      .wrap {
        max-width: 30rem;
        margin: 0 auto;
        padding: 0 1.1rem 4rem;
      }

      header.site {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-bottom: 1px solid var(--rule);
        padding: 1.1rem 0;
        margin-bottom: 0.25rem;
      }

      .brand {
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }

      /* Nameplate: upright serif wordmark (same face as the headlines below
         it, normal weight — no italic, no rule), letter-spaced caps like
         the reference masthead. Tagline in small spaced mono caps, in the
         site's own accent color rather than the reference's gold. */
      .wordmark {
        font-family: ui-serif, Georgia, 'Times New Roman', serif;
        font-weight: 400;
        font-size: 1.3rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        line-height: 1;
        text-decoration: none;
        color: var(--ink);
      }

      .tagline {
        margin: 0.25rem 0 0;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.6rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent);
        white-space: nowrap;
      }

      /* ---------- Article header: back link + inline category ---------- */

      /* Trial: dark header, per reference. Only .article-header — the rest
         of the page (progress rule, article body) stays on the normal
         light background. */
      .article-header {
        gap: 0.7rem;
        margin-bottom: 0;
        background: var(--ink);
        border-bottom-color: transparent;
        /* Break out of .wrap's side padding so the dark bar reaches the
           actual screen edges instead of stopping at the content column. */
        margin-left: -1.1rem;
        margin-right: -1.1rem;
        padding-left: 1.1rem;
        padding-right: 1.1rem;
      }

      .article-header .back-link,
      .article-header .wordmark-small,
      .article-header .icon-btn {
        color: var(--paper);
      }

      .article-header .article-divider {
        background: rgba(251, 250, 247, 0.25);
      }

      .article-header .article-category {
        color: rgba(251, 250, 247, 0.6);
      }

      .back-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        flex: 0 0 auto;
        color: var(--ink);
      }

      .back-link svg {
        width: 1rem;
        height: 1rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .brand-inline {
        flex: 1 1 auto;
        min-width: 0;
        flex-direction: row;
        align-items: baseline;
        gap: 0.6rem;
      }

      .wordmark-small {
        font-size: 0.85rem;
        white-space: nowrap;
      }

      .article-divider {
        flex: 0 0 auto;
        width: 1px;
        height: 0.8rem;
        background: var(--rule);
      }

      .article-category {
        flex: 1 1 auto;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .progress-track {
        height: 2px;
        background: var(--rule);
        margin-bottom: 0.25rem;
        /* Match the header above it edge to edge. */
        margin-left: -1.1rem;
        margin-right: -1.1rem;
      }

      .progress-fill {
        height: 100%;
        width: 0%;
        background: var(--accent);
      }

      /* ---------- Header icon buttons ---------- */

      .icon-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        padding: 0;
        border: none;
        background: none;
        color: var(--ink);
        cursor: pointer;
      }

      .icon-btn svg {
        width: 1.05rem;
        height: 1.05rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.6;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      /* ---------- Header menu: search + section nav, one panel ---------- */

      .menu {
        position: relative;
        flex: 0 0 auto;
      }

      .menu-panel {
        position: absolute;
        z-index: 20;
        top: calc(100% + 0.6rem);
        left: 0;
        width: min(22rem, calc(100vw - 2.4rem));
        max-height: calc(100vh - 6rem);
        overflow-y: auto;
        background: var(--paper);
        border: 1px solid var(--rule);
        box-shadow: 0 8px 24px rgba(22, 22, 26, 0.1);
        padding: 1.1rem;
      }

      /* Article header puts the hamburger on the right — anchor the panel
         to that same edge instead of overflowing off-screen. */
      .article-header .menu-panel {
        left: auto;
        right: 0;
      }

      .menu-block + .menu-block {
        margin-top: 1.1rem;
        padding-top: 1.1rem;
        border-top: 1px solid var(--rule);
      }

      .menu-label {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 0.6rem;
      }

      .menu-nav {
        display: flex;
        flex-direction: column;
      }

      .menu-nav a {
        padding: 0.5rem 0;
        text-decoration: none;
        color: var(--ink);
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.92rem;
        border-top: 1px solid var(--rule);
      }

      .menu-nav a:first-of-type {
        border-top: none;
      }

      .menu-nav a:hover,
      .menu-nav a:focus-visible {
        color: var(--accent);
      }

      /* Search field, nested inside the menu panel */

      .search-field {
        position: relative;
      }

      .search-field .search-icon {
        position: absolute;
        left: 0.6rem;
        top: 50%;
        transform: translateY(-50%);
        width: 0.85rem;
        height: 0.85rem;
        fill: none;
        stroke: var(--muted);
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        pointer-events: none;
      }

      .search-input {
        width: 100%;
        padding: 0.5rem 0.7rem 0.5rem 2rem;
        border: 1px solid var(--rule);
        border-radius: 2px;
        background: var(--paper);
        color: var(--ink);
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.88rem;
      }

      .search-input::placeholder {
        color: var(--muted);
      }

      .search-results {
        margin: 0.75rem 0 0;
        padding: 0;
        list-style: none;
        max-height: 40vh;
        overflow-y: auto;
      }

      .search-results li + li {
        border-top: 1px solid var(--rule);
      }

      .search-results a {
        display: block;
        padding: 0.6rem 0.1rem;
        text-decoration: none;
      }

      .search-result-title {
        display: block;
        font-family: ui-serif, Georgia, 'Times New Roman', serif;
        font-weight: 600;
        font-size: 0.9rem;
        line-height: 1.3;
        color: var(--ink);
      }

      .search-results a:hover .search-result-title,
      .search-results a:focus-visible .search-result-title {
        color: var(--accent);
      }

      .search-results .meta {
        display: block;
        margin-top: 0.25rem;
      }

      .search-empty {
        padding: 0.6rem 0.1rem;
        color: var(--muted);
        font-style: italic;
        font-size: 0.85rem;
      }

      a {
        color: inherit;
      }

      /* Headlines: serif. Metadata: mono. Body copy of a story: sans. */
      h1,
      h2,
      h3,
      .headline {
        font-family: ui-serif, Georgia, 'Times New Roman', serif;
        font-weight: 600;
        line-height: 1.28;
        margin: 0;
      }

      .meta {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.72rem;
        letter-spacing: 0.01em;
        color: var(--muted);
      }

      .meta .dot {
        margin: 0 0.35em;
        opacity: 0.6;
      }

      .meta .handle {
        color: var(--accent);
      }

      .empty {
        color: var(--muted);
        font-style: italic;
        padding: 2rem 0;
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      /* ---------- Feed (index page) ---------- */

      .chip-rail {
        display: flex;
        gap: 0.5rem;
        overflow-x: auto;
        padding: 0.25rem 0 1.1rem;
        margin-bottom: 0.25rem;
        scrollbar-width: none;
      }

      .chip-rail::-webkit-scrollbar {
        display: none;
      }

      .chip {
        flex: 0 0 auto;
        padding: 0.35rem 0.75rem;
        border: 1px solid var(--rule);
        border-radius: 3px;
        background: transparent;
        color: var(--muted);
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.8rem;
        cursor: pointer;
      }

      .chip.is-active {
        border-color: var(--accent);
        color: var(--accent);
      }

      .breaking-banner {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.6rem 0.75rem;
        margin-bottom: 1.1rem;
        background: rgba(47, 79, 79, 0.08);
        border: 1px solid var(--accent);
        border-radius: 2px;
        text-decoration: none;
        color: inherit;
      }

      .breaking-label {
        flex: 0 0 auto;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--accent);
      }

      .breaking-headline {
        font-family: ui-serif, Georgia, 'Times New Roman', serif;
        font-weight: 600;
        font-size: 0.92rem;
        color: var(--ink);
      }

      /* Lead story */
      .lead {
        display: block;
        text-decoration: none;
        color: inherit;
        padding-bottom: 1.1rem;
        border-bottom: 1px solid var(--rule);
        margin-bottom: 0.25rem;
      }

      .lead:hover .headline {
        color: var(--accent);
      }

      .lead-image {
        display: block;
        width: 100vw;
        height: auto;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        margin-bottom: 0.75rem;
        background: var(--rule);
        /* Break out to the screen edges regardless of how deeply nested/
           centered the column around it is (.home caps at 42rem and
           centers itself at the desktop breakpoint, so a fixed negative
           margin matching .wrap's padding — like the article header
           uses — wouldn't reach far enough here). */
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
      }

      .eyebrow {
        display: block;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 0.35rem;
      }

      .lead .headline {
        font-size: 1.3rem;
      }

      .lead .brief {
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.95rem;
        color: #3a3a40;
        margin: 0.4rem 0 0.5rem;
        line-height: 1.4;
      }

      /* Ranked list */
      .ranked-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .ranked-row {
        border-top: 1px solid var(--rule);
      }

      .ranked-row[hidden] {
        display: none;
      }

      .ranked-row .story-link {
        display: block;
        text-decoration: none;
        color: inherit;
        padding: 1.1rem 0;
      }

      .ranked-row .story-link:hover .headline {
        color: var(--accent);
      }

      .story-row {
        display: flex;
        align-items: flex-start;
        gap: 0.7rem;
      }

      .story-row .thumb {
        flex: 0 0 128px;
        width: 128px;
        height: 96px;
        object-fit: cover;
        background: var(--rule);
      }

      /* No thumbnail: a thin left rule anchors the row instead */
      .story-row.no-image {
        border-left: 2px solid var(--rule);
        padding-left: 0.7rem;
      }

      .story-row .story-body {
        flex: 1;
        min-width: 0;
      }

      .story-row .headline {
        font-size: 1rem;
      }

      .story-row .story-body .meta {
        margin-top: 0.35rem;
      }

      .ranked-empty {
        padding: 1.5rem 0;
        color: var(--muted);
        font-style: italic;
        font-size: 0.9rem;
        border-top: 1px solid var(--rule);
      }

      /* Section navigation, echoed at the bottom of a long list */
      .sections-grid {
        margin-top: 1.5rem;
        padding-top: 1.1rem;
        border-top: 1px solid var(--rule);
      }

      .sections-label {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 0.75rem;
      }

      .sections-items {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem 1rem;
      }

      .section-link {
        text-align: left;
        padding: 0.4rem 0;
        border: none;
        background: none;
        color: var(--ink);
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.88rem;
        cursor: pointer;
      }

      .section-link:hover,
      .section-link.is-active {
        color: var(--accent);
      }

      /* ---------- Article page ---------- */

      .article-region {
        display: inline-block;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent);
        border: 1px solid var(--rule);
        border-radius: 2px;
        padding: 0.15em 0.5em;
        margin-bottom: 0.6rem;
      }

      article h1 {
        font-size: clamp(1.5rem, 5vw, 1.9rem);
        margin-bottom: 0.6rem;
      }

      .article-image {
        margin: 1rem -1.1rem;
      }

      .article-image img {
        display: block;
        width: 100%;
        height: auto;
      }

      .article-image figcaption {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.68rem;
        color: var(--muted);
        padding: 0.35rem 1.1rem 0;
      }

      .article-body {
        font-family: ui-serif, Georgia, 'Times New Roman', serif;
        font-size: 1.05rem;
        line-height: 1.65;
        color: #232326;
      }

      .article-body p {
        margin: 0 0 1rem;
      }

      .article-body a {
        color: var(--accent);
      }

      .source-attribution {
        margin-top: 2.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--rule);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.78rem;
        color: var(--muted);
        word-break: break-word;
      }

      .source-attribution a {
        color: var(--accent);
      }

      /* ---------- Keep-reading infinite scroll (article page) ---------- */

      .story + .story-divider {
        margin-top: 3rem;
      }

      .story-divider {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 3rem 0 2rem;
        color: var(--muted);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.7rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .story-divider::before,
      .story-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--rule);
      }

      .story-loading {
        margin: 3rem 0;
        color: var(--muted);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.78rem;
        text-align: center;
      }

      .end-of-feed {
        margin: 3rem 0 1rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--rule);
        color: var(--muted);
        font-size: 0.9rem;
        text-align: center;
      }

      .end-of-feed a {
        color: var(--accent);
      }

      /* ---------- Desktop (>=1024px) ---------- */

      @media (min-width: 1024px) {
        .wrap {
          max-width: 1200px;
          padding: 0 2rem 4rem;
        }

        /* More breathing room once the header isn't fighting a narrow viewport. */
        .menu-panel {
          width: 24rem;
        }

        /* .wrap's side padding grew to 2rem here — match it so the
           article header + progress rule still reach the screen edges. */
        .article-header {
          margin-left: -2rem;
          margin-right: -2rem;
          padding-left: 2rem;
          padding-right: 2rem;
        }

        .progress-track {
          margin-left: -2rem;
          margin-right: -2rem;
        }

        /* No sidebar in this layout — cap the reading width on the
           homepage's ranked list and on article pages instead of letting
           either stretch across the full 1200px wrap. */
        .home,
        .story-feed {
          max-width: 42rem;
          margin: 0 auto;
        }

        .chip-rail {
          overflow-x: visible;
          flex-wrap: wrap;
        }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      {
        articleCategory ? (
          <Fragment>
            <header class="site article-header">
              <a href="/" class="back-link" aria-label="Back to home">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <polyline points="15 6 9 12 15 18" />
                </svg>
              </a>

              <div class="brand brand-inline">
                <a href="/" class="wordmark wordmark-small">
                  The South Press
                </a>
                <span class="article-divider" aria-hidden="true" />
                <span class="article-category">{articleCategory}</span>
              </div>

              <div class="menu" data-menu>
                <button
                  type="button"
                  class="icon-btn"
                  data-menu-toggle
                  aria-expanded="false"
                  aria-label="Open menu"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <line x1="3" y1="7" x2="21" y2="7" />
                    <line x1="3" y1="12" x2="21" y2="12" />
                    <line x1="3" y1="17" x2="21" y2="17" />
                  </svg>
                </button>

                <div class="menu-panel" data-menu-panel hidden>
                  <div class="menu-block">
                    <div class="menu-label">Search</div>
                    <div class="search-field">
                      <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                      </svg>
                      <input
                        type="search"
                        class="search-input"
                        placeholder="Search headlines…"
                        aria-label="Search headlines"
                        autocomplete="off"
                        data-search-input
                      />
                    </div>
                    <ul class="search-results" data-search-results hidden />
                  </div>

                  <div class="menu-block menu-nav">
                    <div class="menu-label">Sections</div>
                    <a href="/">Home</a>
                    {menuRegions.map((region) => (
                      <a href={`/?region=${encodeURIComponent(region)}`}>{region}</a>
                    ))}
                  </div>
                </div>
              </div>
            </header>

            <div class="progress-track" aria-hidden="true">
              <div class="progress-fill" data-progress-fill />
            </div>
          </Fragment>
        ) : (
          <header class="site">
            <div class="menu" data-menu>
              <button type="button" class="icon-btn" data-menu-toggle aria-expanded="false" aria-label="Open menu">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <line x1="3" y1="7" x2="21" y2="7" />
                  <line x1="3" y1="12" x2="21" y2="12" />
                  <line x1="3" y1="17" x2="21" y2="17" />
                </svg>
              </button>

              <div class="menu-panel" data-menu-panel hidden>
                <div class="menu-block">
                  <div class="menu-label">Search</div>
                  <div class="search-field">
                    <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
                      <circle cx="11" cy="11" r="7" />
                      <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>
                    <input
                      type="search"
                      class="search-input"
                      placeholder="Search headlines…"
                      aria-label="Search headlines"
                      autocomplete="off"
                      data-search-input
                    />
                  </div>
                  <ul class="search-results" data-search-results hidden />
                </div>

                <div class="menu-block menu-nav">
                  <div class="menu-label">Sections</div>
                  <a href="/">Home</a>
                  {menuRegions.map((region) => (
                    <a href={`/?region=${encodeURIComponent(region)}`}>{region}</a>
                  ))}
                </div>
              </div>
            </div>

            <div class="brand">
              <a href="/" class="wordmark">
                The South Press
              </a>
              <p class="tagline">perspective that matter</p>
            </div>
          </header>
        )
      }
      <slot />
    </div>

    <script type="application/json" data-search-index set:html={searchIndexJson} />

    <script>
      // --- Header menu: hamburger opens one panel holding both search and
      // section nav. Opening it focuses the search field directly. ---
      const menu = document.querySelector<HTMLElement>('[data-menu]');
      const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menuPanel = document.querySelector<HTMLElement>('[data-menu-panel]');
      const input = document.querySelector<HTMLInputElement>('[data-search-input]');
      const results = document.querySelector<HTMLUListElement>('[data-search-results]');
      const indexTag = document.querySelector<HTMLScriptElement>('[data-search-index]');

      type SearchPost = { id: string; title: string; description: string; date: string; source: string };

      if (menu && menuToggle && menuPanel) {
        const closeMenu = () => {
          menuPanel.hidden = true;
          menuToggle.setAttribute('aria-expanded', 'false');
          if (results) {
            results.hidden = true;
            results.innerHTML = '';
          }
          if (input) input.value = '';
        };

        menuToggle.addEventListener('click', () => {
          const willOpen = menuPanel.hidden;
          menuPanel.hidden = !willOpen;
          menuToggle.setAttribute('aria-expanded', String(willOpen));
          if (willOpen) input?.focus();
        });

        document.addEventListener('click', (event) => {
          if (!menu.contains(event.target as Node)) closeMenu();
        });

        menu.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            closeMenu();
            menuToggle.focus();
          }
        });
      }

      // --- Search, nested inside the menu panel ---
      if (input && results && indexTag) {
        const posts: SearchPost[] = JSON.parse(indexTag.textContent || '[]');
        const MAX_RESULTS = 8;

        const render = (matches: SearchPost[], query: string) => {
          results.innerHTML = '';

          if (matches.length === 0) {
            const empty = document.createElement('li');
            empty.className = 'search-empty';
            empty.textContent = `No headlines match "${query}".`;
            results.append(empty);
            return;
          }

          for (const post of matches.slice(0, MAX_RESULTS)) {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = `/blog/${post.id}/`;

            const titleEl = document.createElement('span');
            titleEl.className = 'search-result-title';
            titleEl.textContent = post.title;

            const metaEl = document.createElement('span');
            metaEl.className = 'meta';
            metaEl.textContent = `${post.date} · ${post.source}`;

            a.append(titleEl, metaEl);
            li.append(a);
            results.append(li);
          }
        };

        input.addEventListener('input', () => {
          const query = input.value.trim().toLowerCase();

          if (!query) {
            results.hidden = true;
            results.innerHTML = '';
            return;
          }

          const matches = posts.filter(
            (post) =>
              post.title.toLowerCase().includes(query) || post.description.toLowerCase().includes(query)
          );

          render(matches, input.value.trim());
          results.hidden = false;
        });

        input.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowDown' && !results.hidden) {
            event.preventDefault();
            results.querySelector('a')?.focus();
          }
          // Escape is handled by the menu-level listener above (bubbles up)
          // and closes the whole panel, not just the results.
        });

        input.addEventListener('focus', () => {
          if (input.value.trim() && results.childElementCount > 0) {
            results.hidden = false;
          }
        });
      }

      // --- Article reading-progress rule ---
      // A no-op on pages without it (homepage has no [data-progress-fill]).
      // On an article page with "keep reading" infinite scroll, this
      // reflects progress through the whole loaded session, not just the
      // first story — there's no single fixed "end" until the reader
      // stops scrolling.
      const progressFill = document.querySelector<HTMLElement>('[data-progress-fill]');
      if (progressFill) {
        const updateProgress = () => {
          const scrollable = document.documentElement.scrollHeight - window.innerHeight;
          const pct = scrollable > 0 ? Math.min(100, Math.max(0, (window.scrollY / scrollable) * 100)) : 0;
          progressFill.style.width = `${pct}%`;
        };

        updateProgress();
        window.addEventListener('scroll', updateProgress, { passive: true });
        window.addEventListener('resize', updateProgress);
      }
    </script>
  </body>
</html>
